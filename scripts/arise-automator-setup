#!/usr/bin/env bash
# ariseOS: gets the server ready to take over the Arise YouTube nightly job,
# following SERVER_HANDOFF.md in Rehchu/arise-youtube-automation (sections 3 to 7).
#
#   sudo bash scripts/arise-automator-setup [--dry-run] [--src DIR]
#
# Run by installer/install.sh and by `arisectl automator setup`; safe to run
# again. It makes the server READY. It never makes the server the runner: that
# is automator/runner.json on the PC, Bradly's change (docs/AUTOMATOR.md).
#   1. the user arise-yt, and the folders it owns (nothing else of ariseOS's)
#   2. /etc/arise/arise.env (paths only), if it is not there yet
#   3. a read-only deploy key and GitHub's published host keys
#   4. the checkout of the private repo, on branch main, owned by arise-yt
#   5. the automator's Python libraries in the venv
#   6. logrotate for last-run.log
# What it cannot do, and prints: Bradly adds the deploy key on GitHub, publishes
# the OAuth app and creates the "ariseOS server" client in the Cloud Console,
# copies its JSON in, and signs in once (arisectl automator signin).
set -uo pipefail

DRY_RUN=0
SRC="$(cd "$(dirname "$0")/.." && pwd)"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --src) SRC="$2"; shift 2 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done

U=arise-yt
UID_WANTED=1502
STATE=/var/lib/arise/automator
SECRETS=/etc/arise/secrets/youtube
ENVF=/etc/arise/arise.env
KH=/etc/arise/automator/github_known_hosts
PARENT=/srv/arise/automator
REPO_DIR=$PARENT/ARISE_YouTube_Updater
REMOTE=git@github.com:Rehchu/arise-youtube-automation.git
VENV=/opt/arise/venv
KEY=$SECRETS/deploy_key
FAILED=0; NEEDS=()

say()  { printf '  %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }
run()  { if [ "$DRY_RUN" = 1 ]; then printf '  [dry-run] %s\n' "$*"; else "$@"; fi; }
as_u() { if [ "$DRY_RUN" = 1 ]; then printf '  [dry-run] (as %s) %s\n' "$U" "$*"; else runuser -u "$U" -- "$@"; fi; }

if [ "$DRY_RUN" = 0 ] && [ "$(id -u)" != 0 ]; then echo "run as root (sudo)" >&2; exit 1; fi
echo "== The YouTube automator (ready, not the runner)"

# 1. the user and its folders
if id -u "$U" >/dev/null 2>&1; then say "user $U exists"; else
  run groupadd -g "$UID_WANTED" "$U" 2>/dev/null || run groupadd "$U"
  run useradd -u "$UID_WANTED" -g "$U" -M -d "$STATE" -s /usr/sbin/nologin -c "ariseOS YouTube automator" "$U" \
    || run useradd -g "$U" -M -d "$STATE" -s /usr/sbin/nologin -c "ariseOS YouTube automator" "$U"
fi
getent group arise-conf >/dev/null 2>&1 && run usermod -aG arise-conf arise-yt   # may read arise.toml (no secrets in it)
run install -d -m 0750 -o "$U" -g "$U" "$STATE" "$STATE/reports"
run install -d -m 0700 -o root -g root /etc/arise/secrets
run install -d -m 0700 -o "$U" -g "$U" "$SECRETS"
run install -d -m 0755 -o "$U" -g "$U" "$PARENT"
run install -d -m 0755 /etc/arise/automator

# 2. the environment file (paths only)
if [ -f "$ENVF" ]; then say "$ENVF present (left as it is)"; else
  run install -m 0644 "$SRC/config/automator/arise.env" "$ENVF"
fi

# 3. the deploy key and GitHub's host keys
run install -m 0644 "$SRC/config/automator/github_known_hosts" "$KH"
if [ -f "$KEY" ]; then say "deploy key present"; else
  as_u ssh-keygen -q -t ed25519 -N '' -C "ariseOS read-only deploy key ($(hostname))" -f "$KEY"
fi
SSHCMD="ssh -i $KEY -o IdentitiesOnly=yes -o UserKnownHostsFile=$KH -o StrictHostKeyChecking=yes"

# 4. the checkout
if [ -d "$REPO_DIR/.git" ]; then
  say "checkout present at $REPO_DIR"
  run chown -R "$U:$U" "$REPO_DIR"
  as_u git -C "$REPO_DIR" remote set-url origin "$REMOTE"
  as_u git -C "$REPO_DIR" config core.sshCommand "$SSHCMD"
  if [ "$DRY_RUN" = 0 ] && ! runuser -u "$U" -- git -C "$REPO_DIR" fetch --quiet origin main 2>/dev/null; then
    NEEDS+=("the deploy key on GitHub (below): the checkout is there but cannot fetch")
  fi
else
  if [ "$DRY_RUN" = 1 ]; then
    say "[dry-run] (as $U) GIT_SSH_COMMAND='$SSHCMD' git clone --branch main $REMOTE $REPO_DIR"
  elif runuser -u "$U" -- env GIT_SSH_COMMAND="$SSHCMD" git clone --quiet --branch main "$REMOTE" "$REPO_DIR" 2>/dev/null; then
    runuser -u "$U" -- git -C "$REPO_DIR" config core.sshCommand "$SSHCMD"
    say "cloned $REMOTE (main) at $(runuser -u "$U" -- git -C "$REPO_DIR" rev-parse --short HEAD)"
  else
    NEEDS+=("the deploy key on GitHub (below), then: sudo arisectl automator setup")
  fi
fi

# 5. the automator's libraries (handoff section 3)
if [ -x "$VENV/bin/pip" ]; then
  if [ -f "$REPO_DIR/requirements.txt" ]; then run "$VENV/bin/pip" install -q -r "$REPO_DIR/requirements.txt" || FAILED=1; fi
  run "$VENV/bin/pip" install -q google-api-python-client google-auth-oauthlib pillow tzdata youtube-transcript-api || FAILED=1
else
  warn "no venv at $VENV yet (install.sh makes it); the libraries go in on the next run"
fi

# 6. logrotate
run install -m 0644 "$SRC/config/logrotate/arise-automator" /etc/logrotate.d/arise-automator

# What only Bradly can do
[ -f "$SECRETS/client_secret.json" ] || NEEDS+=("the server's own OAuth client JSON at $SECRETS/client_secret.json (Cloud Console, docs/AUTOMATOR.md step 2)")
[ -f "$SECRETS/token.json" ] || NEEDS+=("the server's sign-in: sudo arisectl automator signin")
if [ ${#NEEDS[@]} -gt 0 ]; then
  echo "  Still needs Bradly:"
  for n in "${NEEDS[@]}"; do echo "    - $n"; done
  if [ -f "$KEY.pub" ]; then
    echo "  The deploy key to add, READ-ONLY (leave \"Allow write access\" unticked):"
    echo "    github.com/Rehchu/arise-youtube-automation -> Settings -> Deploy keys -> Add deploy key, title \"ariseOS server\""
    echo "    $(cat "$KEY.pub")"
  fi
fi
if [ "$FAILED" = 1 ]; then echo "  automator setup finished with failures (above)"; exit 1; fi
echo "  ready. The 02:05 timer may stay on: while runner.json names the PC it writes a \"not the runner\" report and changes nothing."
