#!/usr/bin/env bash
# ariseOS: Bradly's own Linux account is the box's owner (Oct 28: "the Automator
# doesn't need its own profile, it can run on mine"; "my login of Claude must have
# full file access to modify, update").
#
#   sudo bash scripts/arise-owner-setup [--owner NAME] [--dry-run] [--src DIR]
#
# NAME defaults to [owner] user in /etc/arise/arise.toml, then to the account that
# ran sudo. Never root. Run by install.sh and by `arisectl owner setup`; safe to
# run again. It:
#   1. records the owner in arise.toml ([owner] user)
#   2. adds the account to every ariseOS group: sudo, arise-conf (arise.toml),
#      arise-repos (/srv/arise/repos), arise-claude (the archive), docker, adm and
#      systemd-journal (logs)
#   3. lets it use sudo without a password (/etc/sudoers.d/arise-owner, checked
#      with visudo first), so Claude Code signed in as Bradly can change anything
#   4. keeps its runtime folder alive (loginctl enable-linger), which Claude
#      Desktop on the monitor uses
#   5. gives Claude Code on the box the ariseOS folders and accepts its edits
#      (~/.claude/settings.json, merged, never replaced). Reading the credential
#      files stays refused there, because a credential must never enter a chat.
# The 02:05 job runs as this account too: scripts/arise-automator-setup reads
# the same [owner] user and writes the units' User= drop-in.
#
# Round 6, 23: [owners] users (Kristina: "the same as me") get steps 2 and 3 as well:
# every group and sudo without a password. Steps 4 and 5 (Claude) and the 02:05 job
# stay the owner's alone. --also NAME adds one for this run without editing arise.toml.
set -uo pipefail

DRY_RUN=0
OWNER=""
ALSO=()
SRC="$(cd "$(dirname "$0")/.." && pwd)"
CONF=/etc/arise/arise.toml
while [ $# -gt 0 ]; do
  case "$1" in
    --owner) OWNER="$2"; shift 2 ;;
    --also) ALSO+=("$2"); shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --src) SRC="$2"; shift 2 ;;
    --conf) CONF="$2"; shift 2 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done
say()  { printf '  %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }
run()  { if [ "$DRY_RUN" = 1 ]; then printf '  [dry-run] %s\n' "$*"; else "$@"; fi; }

# The owner: the flag, then arise.toml, then whoever ran sudo.
owner_from_conf() {
  [ -r "$CONF" ] || return 0
  python3 - "$CONF" <<'PY' 2>/dev/null
import sys, tomllib
try:
    print((tomllib.load(open(sys.argv[1], "rb")).get("owner") or {}).get("user", ""))
except Exception:
    pass
PY
}
# Round 6, 23: more accounts with the owner's powers ([owners] users; Kristina: "the same as me").
owners_from_conf() {
  [ -r "$CONF" ] || return 0
  python3 - "$CONF" <<'PY' 2>/dev/null
import sys, tomllib
try:
    for u in (tomllib.load(open(sys.argv[1], "rb")).get("owners") or {}).get("users", []) or []:
        print(str(u))
except Exception:
    pass
PY
}
[ -n "$OWNER" ] || OWNER="$(owner_from_conf)"
[ -n "$OWNER" ] || OWNER="${SUDO_USER:-}"
echo "== The owner's account (Bradly's): runs the automator, full access for his Claude"
if [ -z "$OWNER" ] || [ "$OWNER" = root ]; then
  warn "no owner account: run install.sh with sudo from your own account, or pass --owner NAME"
  exit 1
fi
if ! [[ "$OWNER" =~ ^[a-z_][a-z0-9._-]{0,31}$ ]]; then warn "not a Linux user name: $OWNER"; exit 2; fi
if [ "$DRY_RUN" = 0 ] && [ "$(id -u)" != 0 ]; then echo "run as root (sudo)" >&2; exit 1; fi
if ! id -u "$OWNER" >/dev/null 2>&1; then
  if [ "$DRY_RUN" = 1 ]; then say "[dry-run] $OWNER does not exist here; on the box it is the account Ubuntu's installer made"
  else warn "$OWNER is not an account on this machine (the account Ubuntu's installer made is the usual one)"; exit 1; fi
fi
HOMEDIR="$(getent passwd "$OWNER" | cut -d: -f6)"; HOMEDIR="${HOMEDIR:-/home/$OWNER}"
GRP="$(id -gn "$OWNER" 2>/dev/null || echo "$OWNER")"
say "owner: $OWNER (home $HOMEDIR, group $GRP)"
# The other owners: real accounts on this box only; the 02:05 job and Claude stay $OWNER's.
EXTRA=()
for u in $(owners_from_conf) "${ALSO[@]}"; do
  [ "$u" = "$OWNER" ] && continue
  if ! [[ "$u" =~ ^[a-z_][a-z0-9._-]{0,31}$ ]] || [ "$u" = root ]; then warn "[owners] users: not a Linux user name: $u (skipped)"; continue; fi
  if id -u "$u" >/dev/null 2>&1 || [ "$DRY_RUN" = 1 ]; then EXTRA+=("$u"); else warn "[owners] users: $u has no account on this box (skipped; make one with adduser, then run this again)"; fi
done
[ ${#EXTRA[@]} -gt 0 ] && say "also with the owner's powers: ${EXTRA[*]}"

# 1. arise.toml: [owner] user
if [ -f "$CONF" ]; then
  if [ "$DRY_RUN" = 1 ]; then say "[dry-run] [owner] user = \"$OWNER\" in $CONF"
  else python3 - "$CONF" "$OWNER" <<'PY' || warn "could not write [owner] into $CONF"
import re, sys
p, who = sys.argv[1], sys.argv[2]
s = open(p).read()
block = f'[owner]\nuser = "{who}"            # Bradly\'s Linux account: runs the 02:05 job; sudo without a password (Oct 28)\n'
if re.search(r"(?m)^\[owner\]\s*$", s):
    s = re.sub(r'(?ms)^\[owner\]\s*\n(?:(?!^\[).)*', block + "\n", s, count=1)
else:
    s = s.rstrip("\n") + "\n\n" + block
open(p, "w").write(s)
PY
  fi
else
  say "no $CONF yet (install.sh writes it, then calls this again)"
fi

# 2. the groups (made here if a later step has not made them yet)
for g in arise-conf arise-repos arise-claude; do
  getent group "$g" >/dev/null 2>&1 || run groupadd "$g"
done
for who in "$OWNER" "${EXTRA[@]}"; do
  for g in sudo arise-conf arise-repos arise-claude docker adm systemd-journal; do
    if getent group "$g" >/dev/null 2>&1; then
      if id -nG "$who" 2>/dev/null | tr ' ' '\n' | grep -qx "$g"; then :; else run usermod -aG "$g" "$who"; fi
    fi
  done
done
say "groups: sudo arise-conf arise-repos arise-claude docker adm systemd-journal (a new group applies at the next sign-in)"

# 3. sudo without a password, checked before it is put in place
SUD=/etc/sudoers.d/arise-owner
TMP="$(mktemp)"
{
  printf '# ariseOS: Bradly'"'"'s account, full access for him and his Claude (Oct 28), and [owners] users\n'
  printf '# with the same powers (round 6, 23). Written by arise-owner-setup.\n'
  for who in "$OWNER" "${EXTRA[@]}"; do printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$who"; done
} > "$TMP"
if [ "$DRY_RUN" = 1 ]; then grep -v '^#' "$TMP" | while read -r line; do say "[dry-run] $SUD: $line (after visudo -cf)"; done
elif visudo -cf "$TMP" >/dev/null 2>&1; then install -m 0440 -o root -g root "$TMP" "$SUD"; say "sudo without a password: $SUD"
else warn "visudo refused the rule; left out (sudo still asks for the password)"; fi
rm -f "$TMP"

# 4. a runtime folder that outlives a sign-in (Claude Desktop on the monitor runs in it)
command -v loginctl >/dev/null 2>&1 && run loginctl enable-linger "$OWNER" 2>/dev/null || true

# 5. Claude Code's own settings for this account: the ariseOS folders, edits accepted.
if [ "$DRY_RUN" = 1 ]; then say "[dry-run] merge $HOMEDIR/.claude/settings.json (folders, acceptEdits, credential reads refused)"
elif [ -d "$HOMEDIR" ]; then
  install -d -m 0700 -o "$OWNER" -g "$GRP" "$HOMEDIR/.claude"
  python3 - "$HOMEDIR/.claude/settings.json" <<'PY' && chown "$OWNER:$GRP" "$HOMEDIR/.claude/settings.json"
import json, os, sys
p = sys.argv[1]
try:
    s = json.load(open(p))
except (OSError, ValueError):
    s = {}
perm = s.setdefault("permissions", {})
perm.setdefault("defaultMode", "acceptEdits")
dirs = perm.setdefault("additionalDirectories", [])
for d in ["/opt/arise", "/srv/arise", "/etc/arise", "/var/lib/arise", "/var/log/arise", "/mnt/synology"]:
    if d not in dirs:
        dirs.append(d)
deny = perm.setdefault("deny", [])
# A credential must never enter a chat (the automator's rule, and CLAUDE.md rule 6): its file
# is not read into the conversation. Everything else on the box is open to edit.
# The Bash patterns are best-effort (sudo needs no password here, so a shell could still reach a
# file by another spelling); CLAUDE.md rule 6 is the rule, these catch the plain mistakes.
for rule in ["Read(/etc/arise/secrets/**)", "Read(/etc/arise/SAFE-CARD.txt)", "Read(/srv/arise/apps/**/.env)",
             "Bash(*/etc/arise/secrets*)", "Bash(*SAFE-CARD*)", "Bash(*/srv/arise/apps/*/.env*)"]:
    if rule not in deny:
        deny.append(rule)
tmp = p + ".tmp"
with open(tmp, "w") as f:
    json.dump(s, f, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, p)
PY
  say "Claude Code: $HOMEDIR/.claude/settings.json (folders added, edits accepted, credential files not read)"
fi
echo "  done. $OWNER: sudo without a password, every ariseOS group, and the 02:05 job (arise-automator-setup)."
