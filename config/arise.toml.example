# =============================================================================
#  Arise Server — master configuration
#  Lives at /etc/arise/arise.toml (Linux) or C:\Arise\config\arise.toml (Windows mode).
#
#  Written by the installer and by `arisectl`. The dashboard never writes this
#  file; it writes only /var/lib/arise/state.json. Edit by hand with care and
#  restart arise-web afterwards:  sudo systemctl restart arise-web
#
#  Secrets never go here. They live in /etc/arise/secrets/ (mode 0600):
#    restic-password   the restic repository password
#    synology.cred     username= / password= / domain=  for the SMB mount
#    dsm.json          {"user": "...", "pass": "..."} for the optional DSM API
# =============================================================================

[system]
hostname = "arise-server"
timezone = "America/Chicago"
# "server"  = the Linux install: directory, files, automator, backups, apps.
# "windows" = Windows mode: dashboard, automator, backups only (no directory).
profile = "server"
data_root = "/srv/arise"

[web]
# 0.0.0.0 = reachable from the church LAN. The dashboard has its own login.
bind = "0.0.0.0"
port = 4147
# bcrypt hash of the dashboard password, written by `arisectl admin set-password`.
# Empty = nobody can log in until it is set.
admin_user = "bradly"
admin_password_hash = ""
session_hours = 8760   # a year: a browser or phone stays signed in until they sign out (round 3, 38). The closet monitor still locks at ten minutes.
# Everyone in the directory may sign in with their domain password. Members get
# their own files, the shares their groups allow, share links, Sermons, Bible.
member_login = true
# Members of this group get the administrator's desktop as well.
admins_group = "Domain Admins"
# The address share links are written with. Empty = whatever address the person
# used to open the dashboard. Set it once Caddy/HTTPS is up, e.g. "https://arise.arisecenla.church".
public_url = ""

# The church itself: the widgets, the lock screen, the lobby signage and the
# Sunday app read this. Times are 24-hour, local (America/Chicago).
[church]
name = "Arise Church"
city = "Pineville, LA"
tagline = ""
services = [
  { name = "Sunday Service", day = "Sunday", time = "10:30", site = "Pineville" },
  { name = "Sunday Service", day = "Sunday", time = "10:00", site = "Alexandria" },
  { name = "Glory Night",    day = "Monday", time = "19:00", site = "Pineville" },
]
# The Sunday app's checklist, one line per item; ticks reset each week.
# Leave it out to get the default list (server/arise_server/church.py).
# sunday_checklist = ["Streaming Mac on", "Cameras answering", "Slides updated"]

# Mass email to the church family, through Resend (resend.com). The API key is
# a root-only file. from_email must be at a domain VERIFIED in Resend: not
# gmail.com. reply_to may be the Gmail inbox. audience_id is created on first
# use and remembered in /var/lib/arise/mail.json; set it here to pin one.
[mail]
provider = "resend"
api_key_file = "/etc/arise/secrets/resend-api-key"
from_name = "Arise Church"
from_email = ""           # e.g. "news@mail.arisecenla.com" once the domain is verified in Resend
reply_to = ""             # e.g. the church Gmail
audience_name = "Arise Church family"

# Push notifications to phones (answer 10: Bradly only). The admin_user always
# may subscribe; add more names here to widen it. Keys are made on the box.
[push]
users = []

[links]
# Share links (a public download address for one file or folder).
days = 0        # default life in days; 0 = never expires, it lives until removed (Bradly, Oct 28)
max_days = 365  # the longest life a link may be given when one is picked
max_zip_bytes = 2147483648   # folders bigger than this are not zipped


[directory]
# The Samba Active Directory Domain Controller. Provisioned by install.sh.
enabled = true
realm = "AD.ARISECENLA.COM"
netbios = "ARISE"
# Where the DC sends lookups it does not own (everything that is not the realm).
dns_forwarder = "1.1.1.1"
# Where domain users' home folders live. Local disk at first; switch to
# "/mnt/synology/homes" once the NAS is joined to the domain (docs/SYNOLOGY.md).
homes_path = "/srv/arise/homes"

# Bradly's own Linux account (Oct 28: "the Automator doesn't need its own profile, it can run on mine").
# It runs the 02:05 job and has sudo without a password, so his Claude can change anything.
# install.sh fills it in from the account that ran sudo (or --owner NAME).
[owner]
user = ""

[automator]
# The nightly YouTube job. The checkout is a clone of Rehchu/arise-youtube-automation;
# token.json and client_secret.json go in that folder by hand (never in git).
enabled = true
path = "/srv/arise/automator/ARISE_YouTube_Updater"
python = "/opt/arise/venv/bin/python"
# Local time, America/Chicago. 02:05 = five minutes after the YouTube quota resets.
# The systemd timer carries the same time; change both or use `arisectl automator schedule`.
schedule = "02:05"

[backups]
# restic repository. On the Synology once it is mounted; the first `arisectl backup run`
# initialises it. The password file must exist first (install.sh prints how).
restic_repo = "/mnt/synology/arise-backups/restic"
password_file = "/etc/arise/secrets/restic-password"
schedule = "03:00"
# Retention: restic forget --keep-daily 14 --keep-weekly 8 --keep-monthly 12, then prune.
keep_daily = 30
keep_weekly = 12
keep_monthly = 24   # Bradly: more history than the default (docs/ANSWERS.md 47)
jobs_file = "/etc/arise/backups.yaml"

[nas]
# The 4-bay Synology. Model and DSM version: not known yet — fill in docs/SYNOLOGY.md
# once it is on the bench.
enabled = true
host = "synology.ad.arisecenla.com"
mount = "/mnt/synology"
# "smb" (works once the NAS is in the domain) or "nfs" (simplest if it is not).
protocol = "smb"
share = "arise"
# Optional: the DSM web API for health, disk and Hyper Backup status in the dashboard.
# Leave empty to skip. e.g. "https://synology.ad.arisecenla.com:5001"
dsm_url = ""
dsm_credentials_file = "/etc/arise/secrets/dsm.json"

[apps]
# Docker Compose templates from templates/. Off in Windows mode.
docker = true
root = "/srv/arise/apps"

[github]
# Bare mirrors of every Arise repo, refreshed at 04:00 and included in the backups.
# Private repos need a token in /etc/arise/secrets/github-token (one line).
mirror = true
mirror_path = "/srv/arise/backups/github-mirror"
repos = [
  "Rehchu/Church-server-OS-", "Rehchu/arise-youtube-automation", "Rehchu/arisechurch",
  "Rehchu/arisehub", "Rehchu/arise-church-backup", "Rehchu/arise-youtube",
  "Rehchu/projectbackups", "Rehchu/ai-chat-backups"
]

# -----------------------------------------------------------------------------
# Remote access (v0.2). See docs/REMOTE-ACCESS.md.
# vpn: "tailscale" (recommended, no port-forward), "wireguard" (self-hosted,
# UDP 51820 forwarded on the Pineville router), or "none".
# -----------------------------------------------------------------------------
[remote]
ssh_port = 22
vpn = "tailscale"
wg_interface = "wg0"
wg_endpoint = ""                   # e.g. "arise.duckdns.org:51820" once the router forwards it
wg_subnet = "10.47.0.0/24"
lan_subnet = "192.168.1.0/24"
guacamole_url = "http://arise-server:8084"

# The daily note (07:00): what needs you, to a Discord or Slack webhook.
# Leave webhook_url empty and nothing is sent; the dashboard still shows it.
# Bradly, Oct 28 2026: no daily note for now (docs/ANSWERS.md 49).
[notify]
webhook_url = ""
hour = 7
only_when_attention = true

# Routers the server may READ (never change): consumer Netgear routers answer
# an "attached devices" question over their SOAP API with the admin password,
# which is how the Network app lists what sits behind the office Netgear
# (its own network, invisible to an ARP scan). Nothing is ever written to a
# router. Google Mesh has no such API; its clients are in the Google Home app.
# kind: netgear. password_file: a root-only file with the router's admin password.
# [[routers]]
# id = "netgear-b"
# name = "Netgear B (office)"
# kind = "netgear"
# host = "10.0.0.1"
# user = "admin"
# password_file = "/etc/arise/secrets/router-netgear-b"

# The campuses. The server lives at the main site; the rest reach it over the
# VPN. probe = a host at that site that is always on (its router, a Mac).
[[sites]]
id = "pineville"
name = "Arise Church Pineville"
kind = "main"
address = "501 Ates Road, Pineville, LA"
subnet = "192.168.1.0/24"
probe = ""
services = "Sunday 10:30 AM · Glory Night Monday 7 PM"
note = "The server, the Synology and the domain live here."

[[sites]]
id = "alexandria"
name = "Arise Church Alexandria"
kind = "campus"
address = ""
subnet = "192.168.2.0/24"
probe = ""
services = "Sunday 10:00 AM"
note = "Reaches the server over the VPN. Macs here bind to the domain through it."

[[sites]]
id = "hub"
name = "The Apostolic Hub"
kind = "office"
address = ""
subnet = "192.168.3.0/24"
probe = ""
services = ""
note = "Office and leadership computers: VPN clients, no site router needed."

# The closet monitor's browser: Firefox in the ariseOS theme (docs/BROWSER.md).
# Applied with: sudo arisectl browser apply   (rewrites the policy, restarts the monitor)
[browser]
open_web = false        # false: only the built-in list (the box, the Assistants, YouTube, StreamYard, the church site) plus `allow`
allow = []              # extra sites, e.g. ["bible.com", "*.planningcenteronline.com"]

# The Arise repos on the server, two-way with GitHub (docs/REPOS.md). The list is [github] repos.
# policy per repo: "all" (pull and push), "branches" (push branches but not the default one), "none" (pull only).
[repos]
enabled = true
root = "/srv/arise/repos"
[repos.policy]
AriseHub = "none"                      # a push to main deploys the live site; a branch push blocks Cloudflare secret changes
Arise-Youtube-Automation = "branches"  # its main is edited on the PC (SERVER_HANDOFF.md)
