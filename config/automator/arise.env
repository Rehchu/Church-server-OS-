# /etc/arise/arise.env: the environment of the YouTube automator's units
# (arise-automator.service and arise-automator-preview.service). Paths only;
# no secrets. Written once by scripts/arise-automator-setup, never overwritten.
#
# The automator's handoff (SERVER_HANDOFF.md in the automator repo) names the
# same variables. ariseOS places three of them differently on purpose, for
# least privilege (docs/AUTOMATOR.md, "Where ariseOS puts it"):
#   the checkout   /srv/arise/automator/ARISE_YouTube_Updater (backed up; /opt/arise is the dashboard's code)
#   the secrets    /etc/arise/secrets/youtube/                (the job cannot read ariseOS's other secrets)
#   the state      /var/lib/arise/automator                   (apart from the audit log and the dashboard's state)
ARISE_RUNNER_NAME=ariseOS
ARISE_TOKEN=/etc/arise/secrets/youtube/token.json
ARISE_CLIENT_SECRET=/etc/arise/secrets/youtube/client_secret.json
ARISE_STATE_DIR=/var/lib/arise/automator
ARISE_REPO=/srv/arise/automator/ARISE_YouTube_Updater
ARISE_PYTHON=/opt/arise/venv/bin/python
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
TZ=America/Chicago
HOME=/var/lib/arise/automator
