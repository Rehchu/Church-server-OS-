[Unit]
Description=Arise Server software updates (installs the queue from Software Update after a system snapshot)
After=network-online.target
Wants=network-online.target
# Ordered after the night's backup; the lock wait covers a run started by hand (scout I-012/I-013).
After=arise-backup.service

[Service]
Type=oneshot
# Security patches are unattended-upgrades' job (step 6f). This installs only what
# Bradly queued in the dashboard, after `arisectl snapshot create`, and reboots only
# if the kernel asks and no service is on. Everything is written to /var/log/arise/updates.log.
# Never during a service (Sundays 10:30, Mondays 19:00, from arise.toml [church]): a firing or a
# Persistent= catch-up inside that window is skipped, not failed. arisectl service-now.
ExecCondition=/usr/local/bin/arisectl service-now --quiet
ExecStart=/usr/local/bin/arisectl update apply --quiet
