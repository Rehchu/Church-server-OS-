[Unit]
Description=Arise Server nightly copy of the channel's text and thumbnails (round 7, 62)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Never during a service (Sundays 10:30, Mondays 19:00, Alexandria's 10:00, Calendar specials).
ExecCondition=/usr/local/bin/arisectl service-now --quiet
ExecStart=/usr/local/bin/arisectl channel copy --quiet
