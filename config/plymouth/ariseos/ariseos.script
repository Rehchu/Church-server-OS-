# ariseOS boot splash. Ink background, the flame centred, a thin red progress
# bar, the name in small caps under it. No Linux text: the kernel is told
# "quiet splash loglevel=3" by the installer. Pictures from scripts/gen-plymouth-art.py.

Window.SetBackgroundTopColor(0.039, 0.039, 0.047);
Window.SetBackgroundBottomColor(0.039, 0.039, 0.047);

w = Window.GetWidth();
h = Window.GetHeight();

flame.image = Image("flame.png");
flame.sprite = Sprite(flame.image);
flame.sprite.SetX(w / 2 - flame.image.GetWidth() / 2);
flame.sprite.SetY(h / 2 - flame.image.GetHeight() / 2 - 40);
flame.sprite.SetOpacity(0.0);

name.image = Image.Text("A R I S E O S", 0.96, 0.95, 0.94, 1, "Sans 11");
name.sprite = Sprite(name.image);
name.sprite.SetX(w / 2 - name.image.GetWidth() / 2);
name.sprite.SetY(h / 2 + flame.image.GetHeight() / 2 + 6);

box.image = Image("progress_box.png");
box.sprite = Sprite(box.image);
box.sprite.SetX(w / 2 - box.image.GetWidth() / 2);
box.sprite.SetY(h / 2 + flame.image.GetHeight() / 2 + 44);

bar.original = Image("progress_bar.png");
bar.sprite = Sprite();
bar.sprite.SetX(box.sprite.GetX());
bar.sprite.SetY(box.sprite.GetY());

# The flame breathes in over the first second; the bar follows the boot.
fun refresh_callback() {
  if (flame.opacity < 1.0) {
    flame.opacity = flame.opacity + 0.04;
    flame.sprite.SetOpacity(flame.opacity);
  }
}
flame.opacity = 0.0;
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  width = Math.Int(bar.original.GetWidth() * progress);
  if (width < 1) width = 1;
  bar.image = bar.original.Scale(width, bar.original.GetHeight());
  bar.sprite.SetImage(bar.image);
}
Plymouth.SetBootProgressFunction(progress_callback);

# Shutdown and reboot show the same picture, bar full.
fun quit_callback() {
  bar.sprite.SetImage(bar.original);
}
Plymouth.SetQuitFunction(quit_callback);

# Messages from the boot (fsck, "A start job is running") are kept small and
# bone, under the bar, instead of a wall of text.
message.sprite = Sprite();
message.sprite.SetX(0);
message.sprite.SetY(h - 40);
fun message_callback(text) {
  message.image = Image.Text(text, 0.6, 0.6, 0.62, 1, "Sans 9");
  message.sprite.SetImage(message.image);
  message.sprite.SetX(w / 2 - message.image.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);

# The disk passphrase (H3: no TPM 2.0, so cryptsetup asks at every boot). Without these three
# callbacks Plymouth draws nothing for the prompt and the box looks hung (scout I-004, Nov 2).
# The prompt and one bullet per typed character sit under the bar, in bone; the bar is hidden
# while a question is open and comes back after.
prompt.sprite = Sprite();
prompt.sprite.SetX(0);
prompt.sprite.SetY(h / 2 + 90);
dots.sprite = Sprite();
dots.sprite.SetY(h / 2 + 124);
fun display_password_callback(text, bullets) {
  if (text == "") text = "Type the disk passphrase";
  prompt.image = Image.Text(text, 0.93, 0.92, 0.9, 1, "Sans 13");
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetX(w / 2 - prompt.image.GetWidth() / 2);
  str = "";
  for (i = 0; i < bullets; i++) str += "• ";
  if (bullets == 0) str = " ";
  dots.image = Image.Text(str, 0.84, 0.13, 0.18, 1, "Sans 16");
  dots.sprite.SetImage(dots.image);
  dots.sprite.SetX(w / 2 - dots.image.GetWidth() / 2);
  bar.sprite.SetOpacity(0);
}
fun display_question_callback(text, entry) {
  prompt.image = Image.Text(text + " " + entry, 0.93, 0.92, 0.9, 1, "Sans 13");
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetX(w / 2 - prompt.image.GetWidth() / 2);
  bar.sprite.SetOpacity(0);
}
fun display_normal_callback() {
  prompt.sprite.SetImage(Image.Text(" ", 0, 0, 0, 0, "Sans 9"));
  dots.sprite.SetImage(Image.Text(" ", 0, 0, 0, 0, "Sans 9"));
  bar.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
