t_mac_settings() {   # round 7, 28-30, 33: what the church wants on every church Mac
  local id="$1" asp=/Library/Preferences/com.apple.appstore
  # The built-in Guest User (round 7, 33): on; macOS deletes everything it made at sign-out.
  sysadminctl -guestAccount on >>"$LOG" 2>&1
  # App Store installs ask for an admin (round 7, 30). The key is the App Store's own
  # "restrict-store-require-admin-to-install" (Apple's MDM restriction "Require admin password to
  # install or update apps"); written here and as a managed preference, the way the Chrome
  # bookmarks are. Not yet confirmed on a current macOS without MDM (docs/MACS.md).
  defaults write "$asp" restrict-store-require-admin-to-install -bool true
  mkdir -p "/Library/Managed Preferences"
  defaults write "/Library/Managed Preferences/com.apple.appstore" restrict-store-require-admin-to-install -bool true
  chmod 644 "/Library/Managed Preferences/com.apple.appstore.plist" 2>/dev/null
  # Never a forced screen lock and never an automatic sign-out (round 7, 28 and 29): nothing set.
  report "$id" done "Guest User on (wiped at sign-out); App Store installs ask for an admin; no screen lock or sign-out timer set"
}

app_team() {   # app_team <path to .app>: its signing team, or nothing
  codesign -dv --verbose=2 "$1" 2>&1 | sed -n 's/^TeamIdentifier=//p' | head -1
}
pkg_ok() {   # pkg_ok <pkg> <team>: signed by that team's Developer ID Installer, and notarized
  local sig
  sig="$(pkgutil --check-signature "$1" 2>&1)" || return 1
  printf '%s\n' "$sig" | grep -q "Developer ID Installer: .*($2)" || return 1
  spctl -a -vv -t install "$1" 2>&1 | grep -q "Notarized Developer ID"
}
t_apps() {   # round 7, 31: each app from its maker, refused unless that maker signed and Apple notarized it
  local id="$1" conf kind name app team url n=0 skip="" bad="" pkg
  conf="$(api config 2>/dev/null)" || { report "$id" failed "could not read the server's settings"; return; }
  while read -r kind name app team url; do
    [ "$kind" = APP ] || continue
    name="$(urldec "$name")"; app="$(urldec "$app")"; team="$(urldec "$team")"; url="$(urldec "$url")"
    if [ -d "/Applications/$app" ] && [ "$(app_team "/Applications/$app")" = "$team" ]; then skip="$skip $name"; continue; fi
    if [ "$url" = - ] || [ -z "$url" ]; then
      # no download link: Nextcloud has its own task; anything else (Proclaim) is installed by hand
      if [ "$name" = Nextcloud ]; then skip="$skip $name(its own task)"
      elif [ -d "/Applications/$app" ]; then bad="$bad $name(the copy here is not signed by $team)"
      else bad="$bad $name(missing: install it by hand from its maker)"; fi
      continue
    fi
    pkg="$(mktemp /tmp/arise-app.XXXXXX)"
    if ! curl -fsSL --max-time 900 -o "$pkg" "$url" >>"$LOG" 2>&1; then bad="$bad $name(download)"; rm -f "$pkg"; continue; fi
    if ! pkg_ok "$pkg" "$team"; then bad="$bad $name(not signed by $team, or not notarized)"; rm -f "$pkg"; continue; fi
    if installer -pkg "$pkg" -target / >>"$LOG" 2>&1; then n=$((n + 1)); else bad="$bad $name(installer)"; fi
    rm -f "$pkg"
  done <<EOF_APPS
$conf
EOF_APPS
  if [ -n "$bad" ]; then report "$id" failed "installed $n; not installed:$bad"
  else report "$id" done "installed $n; already there:${skip:- none}"; fi
}

t_dnsfilter() {   # round 7, 71 and 72: a malware and adult filter for this church Mac's lookups
  # Every network service's DNS servers become the filter; the church domain keeps going to the
  # server through /etc/resolver (that file wins for its own names). The servers each service had
  # before are kept in $DB/dns-before, and mode=off puts them back.
  local id="$1" mode svc key servers conf n=0 saved="$DB/dns-before"
  mode="$(arg mode "$2" || echo on)"
  mkdir -p "$saved"
  conf="$(api config 2>/dev/null)"
  servers="$(cfg_words DNS "$conf" | tr '\n' ' ')"
  if [ "$mode" = on ] && [ -z "${servers// /}" ]; then report "$id" skipped "no DNS filter set on the server ([macs] dns_filter = [])"; return; fi
  while IFS= read -r svc; do
    case "$svc" in ""|"An asterisk"*|\**) continue ;; esac
    key="$(printf '%s' "$svc" | tr -c 'A-Za-z0-9' '_')"
    if [ "$mode" = off ]; then
      if [ -f "$saved/$key" ]; then
        # "Empty" puts the service back on whatever the network hands out
        # shellcheck disable=SC2046
        networksetup -setdnsservers "$svc" $(cat "$saved/$key") >>"$LOG" 2>&1 && n=$((n + 1)) && rm -f "$saved/$key"
      fi
    else
      if [ ! -f "$saved/$key" ]; then
        networksetup -getdnsservers "$svc" 2>/dev/null | grep -Eq '^[0-9a-fA-F:.]+$' \
          && networksetup -getdnsservers "$svc" | tr '\n' ' ' > "$saved/$key" || echo Empty > "$saved/$key"
      fi
      # shellcheck disable=SC2086
      networksetup -setdnsservers "$svc" $servers >>"$LOG" 2>&1 && n=$((n + 1))
    fi
  done <<EOF_SVC
$(networksetup -listallnetworkservices 2>/dev/null | tail -n +2)
EOF_SVC
  dscacheutil -flushcache; killall -HUP mDNSResponder 2>/dev/null
  if [ "$mode" = off ]; then report "$id" done "the DNS filter is off on $n network service(s): each has its servers from before"
  else report "$id" done "$n network service(s) use the filter ($servers); the church domain still asks the server"; fi
}

t_notice() {   # round 7, 84: a Mac notification for one person (or whoever is signed in, for user=)
  local id="$1" user title body u uid shown=0 waits=0
  user="$(arg user "$2" || true)"; title="$(arg title "$2" || echo ariseOS)"; body="$(arg body "$2" || true)"
  if [ -z "$user" ]; then
    while IFS="$(printf '\t')" read -r u uid; do [ -n "$u" ] && show_notice "$u" "$uid" "$title" "$body" && shown=$((shown + 1)); done <<EOF_GUI
$(gui_users)
EOF_GUI
    report "$id" done "shown to $shown signed-in person(s)"; return
  fi
  dscl . -read "/Users/$user" >/dev/null 2>&1 || { report "$id" skipped "$user has no account on this Mac"; return; }
  uid="$(id -u "$user" 2>/dev/null)"
  if [ -n "$uid" ] && launchctl print "gui/$uid" >/dev/null 2>&1 && show_notice "$user" "$uid" "$title" "$body"; then
    report "$id" done "shown to $user"; return
  fi
  # Not signed in: it waits in their own folder, and their session agent shows it at the next sign-in.
  mkdir -p "$NOTICES/$user" && chown "$user" "$NOTICES/$user" 2>/dev/null && chmod 700 "$NOTICES/$user"
  ( umask 077; printf '%s\n%s\n' "$title" "$body" > "$NOTICES/$user/$(date '+%Y%m%d%H%M%S')-$id.notice" )
  chown "$user" "$NOTICES/$user/"*.notice 2>/dev/null; waits=1
  report "$id" done "waits for $user's next sign-in"
}

# ----- a service (round 7, 92): Nextcloud pauses so the stream keeps the bandwidth -------------
nc_pause() {
  local u uid
  while IFS="$(printf '\t')" read -r u uid; do
    [ -n "$u" ] || continue
    pgrep -u "$uid" -x Nextcloud >/dev/null 2>&1 || continue
    as_user "$u" "$uid" osascript -e 'tell application "Nextcloud" to quit' >/dev/null 2>&1
    grep -qx "$u" "$DB/nc-paused" 2>/dev/null || printf '%s\n' "$u" >> "$DB/nc-paused"
  done <<EOF_GUI
$(gui_users)
EOF_GUI
}
nc_resume() {
  local u uid
  [ -s "$DB/nc-paused" ] || { rm -f "$DB/nc-paused"; return 0; }
  while IFS= read -r u; do
    uid="$(id -u "$u" 2>/dev/null)" || continue
    launchctl print "gui/$uid" >/dev/null 2>&1 && as_user "$u" "$uid" open -g -a Nextcloud >/dev/null 2>&1
  done < "$DB/nc-paused"
  rm -f "$DB/nc-paused"
  log "the service is over: Nextcloud is back on"
}

t_ariseadmin() {   # the hidden admin, its password rotated and escrowed (round 6, 7)
  # The new password is kept on disk (root, 0600) before it is set, so a crash between the
  # two never loses it; setting the same one again is harmless. curl reads it from that file:
  # on the command line, any signed-in user could see it with ps.
  # The current one is kept as well (root, 0600; the server holds it anyway): an account with a
  # Secure Token must change its password with the old one (dscl -passwd), or FileVault's copy of
  # it goes stale. sysadminctl's exit code is not trusted: the record is checked instead.
  local id="$1" pw cur p="$DB/ariseadmin.pending" c="$DB/ariseadmin.current"
  if [ -s "$p" ]; then pw="$(cat "$p")"
  else pw="$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)"; ( umask 077; printf '%s' "$pw" > "$p" ); fi
  cur="$(cat "$c" 2>/dev/null)"
  if ! dscl . -read /Users/ariseadmin >/dev/null 2>&1; then
    sysadminctl -addUser ariseadmin -fullName "Arise Admin" -password "$pw" -admin -home /var/ariseadmin >>"$LOG" 2>&1
    dscl . -read /Users/ariseadmin >/dev/null 2>&1 || { report "$id" failed "could not make ariseadmin (see $LOG)"; return; }
    dscl . -create /Users/ariseadmin IsHidden 1
    createhomedir -c -u ariseadmin >/dev/null 2>&1
  elif [ -n "$cur" ] && [ "$cur" = "$pw" ]; then :   # set last time; only the escrow was left
  elif [ -n "$cur" ] && dscl . -passwd /Users/ariseadmin "$cur" "$pw" >>"$LOG" 2>&1; then :
  elif has_token ariseadmin; then
    report "$id" failed "ariseadmin holds a Secure Token and its current password is not known on this Mac; set it once by hand (docs/MACS.md)"; return
  else
    sysadminctl -resetPasswordFor ariseadmin -newPassword "$pw" >>"$LOG" 2>&1 || { report "$id" failed "could not change ariseadmin's password"; return; }
  fi
  ( umask 077; printf '%s' "$pw" > "$c" )
  if api secret --data-urlencode "kind=ariseadmin" --data-urlencode "value@$p" >/dev/null 2>&1; then
    rm -f "$p"; report "$id" done "rotated and escrowed"
  else report "$id" failed "changed, but the server did not take it: kept here and sent next time"; fi
}

t_filevault() {   # on, deferred to the next sign-in; the recovery key escrowed (round 6, 10)
  local id="$1" key kf
  if [ -f "$DB/fv.plist" ]; then
    key="$(defaults read "$DB/fv.plist" RecoveryKey 2>/dev/null)"
    kf="$DB/fv.key"; ( umask 077; printf '%s' "$key" > "$kf" )   # from a file, never the command line
    if [ -n "$key" ] && api secret --data-urlencode "kind=filevault" --data-urlencode "value@$kf" >/dev/null 2>&1; then
      rm -f "$DB/fv.plist" "$kf"; report "$id" done "FileVault on; recovery key escrowed"; return
    fi
    rm -f "$kf"
  fi
  if [ "$(fv_state)" = on ]; then report "$id" done "FileVault already on (its key was escrowed at enrolment, or turn it off and on to escrow)"; return; fi
  if fdesetup enable -defer "$DB/fv.plist" -forceatlogin 0 -dontaskatlogout >>"$LOG" 2>&1; then
    report "$id" skipped "FileVault turns on at the next sign-in; the key is escrowed after that"
  else report "$id" failed "fdesetup refused (see $LOG)"; fi
}

t_printers() {
  local id="$1" n=0 kind name uri drv loc
  rm -f "$DB/printers.count"
  api config 2>/dev/null | while read -r kind name uri drv loc; do
    [ "$kind" = PRINTER ] || continue
    lpadmin -p "$(urldec "$name")" -E -v "$(urldec "$uri")" -m "$(urldec "${drv:-everywhere}")" -L "$(urldec "${loc:-}")" >>"$LOG" 2>&1 && n=$((n + 1))
    echo "$n" > "$DB/printers.count"
  done
  report "$id" done "$(cat "$DB/printers.count" 2>/dev/null || echo 0) printer(s) from the server"
}

xmlesc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
t_bookmarks() {   # the Church folder: Chrome's managed bookmarks, and .webloc files for Safari
  local id="$1" kind name url dir=/Library/Arise/Church\ Links tmp n=0
  mkdir -p "$dir"; tmp="$(mktemp)"
  printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict><key>ManagedBookmarks</key><array><dict><key>toplevel_name</key><string>Church</string></dict>\n' > "$tmp"
  while read -r kind name url; do
    [ "$kind" = BOOKMARK ] || continue
    name="$(urldec "$name")"; url="$(urldec "$url")"
    local xn xu; xn="$(xmlesc "$name")"; xu="$(xmlesc "$url")"
    printf '<dict><key>name</key><string>%s</string><key>url</key><string>%s</string></dict>\n' "$xn" "$xu" >> "$tmp"
    printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict><key>URL</key><string>%s</string></dict></plist>\n' "$xu" > "$dir/${name//\//-}.webloc"
    n=$((n + 1))
  done < <(api config 2>/dev/null)
  printf '</array></dict></plist>\n' >> "$tmp"
  mkdir -p "/Library/Managed Preferences" && mv "$tmp" "/Library/Managed Preferences/com.google.Chrome.plist" && chmod 644 "/Library/Managed Preferences/com.google.Chrome.plist"
  report "$id" done "$n church bookmarks (Chrome's Church folder; Safari: $dir)"
}

t_certificate() {
  if security verify-cert -c "$CACERT" >/dev/null 2>&1; then report "$1" done "the church certificate is trusted"
  else report "$1" failed "the church certificate is not trusted: run the enrol line again in Terminal (macOS asks an admin to approve it)"; fi
}

# pick_updates <current major>: reads `softwareupdate --list` on stdin, prints the labels to install.
# Each item is a "* Label: X" line and a "Title: ..., Version: V, ..." line. Kept: anything whose
# version is in the current major (15.1 -> 15.1.1, 26.0 -> 26.0.1), Security Updates and Rapid
# Security Responses / Background Security Improvements, and Safari's own patches; never a
# different major (a new macOS).
pick_updates() {
  awk -v major="$1" '
    /^[[:space:]]*\* Label: / { if (lab != "") decide(); lab = $0; sub(/^[[:space:]]*\* Label: /, "", lab); ver = ""; next }
    /Version: / && lab != "" { v = $0; sub(/.*Version: /, "", v); sub(/,.*/, "", v); ver = v }
    END { if (lab != "") decide() }
    function decide(  m) {
      m = ver; sub(/\..*/, "", m)
      if (lab ~ /[Ss]ecurity|XProtect|MRT|Gatekeeper/ || lab ~ /^Safari/) print lab
      else if (ver != "" && m == major && lab ~ /^macOS/) print lab
      lab = ""
    }'
}

t_updates() {   # security patches for this macOS, overnight; never a new macOS (round 6, 12)
  local id="$1" l n=0 me uid major su=/Library/Preferences/com.apple.SoftwareUpdate
  # Apple's own channel: check, download, install the critical/config data (XProtect, MRT) and
  # macOS updates. macOS installs updates within its own major version only; a new macOS is an
  # upgrade, which it never does by itself (Bradly clicks those).
  defaults write "$su" AutomaticCheckEnabled -bool true
  defaults write "$su" AutomaticDownload -bool true
  defaults write "$su" CriticalUpdateInstall -bool true
  defaults write "$su" ConfigDataInstall -bool true
  defaults write "$su" AutomaticallyInstallMacOSUpdates -bool true
  major="$(sw_vers -productVersion | cut -d. -f1)"
  # On Apple silicon a macOS update also needs a volume owner's password; root alone cannot give
  # it, so those wait for macOS's own overnight install above (the log says which ones did not take).
  softwareupdate --list 2>/dev/null | pick_updates "$major" > "$DB/updates.list"
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    if softwareupdate --install "$l" </dev/null >>"$LOG" 2>&1; then n=$((n + 1)); else log "softwareupdate could not install $l now (Apple silicon wants a volume owner); macOS installs it overnight"; fi
  done < "$DB/updates.list"
  rm -f "$DB/updates.list"
  if softwareupdate --list 2>/dev/null | grep -qi "restart"; then
    me="$(console_user)"; uid="$(id -u "$me" 2>/dev/null)"
    # In the person's own session (launchctl asuser + sudo -u, the way Apple's tools are run for a user).
    [ -n "$uid" ] && [ "$me" != root ] && launchctl asuser "$uid" sudo -u "$me" osascript -e 'display dialog "A security update for this church Mac is ready. Please restart when you can." buttons {"Later"} default button 1 with title "Arise Church"' </dev/null >/dev/null 2>&1 &
  fi
  report "$id" done "$n update(s) for macOS $major installed; a new macOS waits for Bradly"
}

t_tailscale() {
  local st; st="$(ts_state)"
  if [ "$st" = "not installed" ]; then
    curl -fsSL -o /tmp/tailscale.pkg https://pkgs.tailscale.com/stable/Tailscale-latest-macos.pkg >>"$LOG" 2>&1 && installer -pkg /tmp/tailscale.pkg -target / >>"$LOG" 2>&1
    rm -f /tmp/tailscale.pkg; st="$(ts_state)"
  fi
  # Off-site, the server is reached at its church address through its advertised Tailscale route
  # (docs/REMOTE-ACCESS.md): the check-ins, Nextcloud and the shares all keep working (round 6, 17).
  [ "$st" = up ] && "$TS" set --accept-routes=true >>"$LOG" 2>&1
  case "$st" in up) report "$1" done "Tailscale is up, using the church route" ;; down) report "$1" skipped "Tailscale is installed but signed out: sign in once with the church's Tailscale login" ;; *) report "$1" failed "Tailscale could not be installed" ;; esac
}

t_nextcloud() {   # R6-SYNC fills tasks/nextcloud.sh: install and set up the Nextcloud client for this user
  local id="$1" user local_; user="$(arg user "$2")"; local_="$(arg local "$2" || echo "$user")"
  local tmp out ca=(); tmp="$(mktemp)"
  case "$SERVER" in https:*) [ -f "$CACERT" ] && ca=(--cacert "$CACERT") ;; esac
  # the server's copy wins, so a Mac enrolled before the script existed gets it too
  if curl -fsS --max-time 60 ${ca[@]+"${ca[@]}"} "$SERVER/mac/nextcloud.sh" -o "$tmp" 2>/dev/null && bash -n "$tmp" 2>/dev/null; then
    mkdir -p "$BASE/tasks"; install -m 755 -o root -g wheel "$tmp" "$BASE/tasks/nextcloud.sh"
  fi
  rm -f "$tmp"
  if [ -x "$BASE/tasks/nextcloud.sh" ]; then
    if out="$("$BASE/tasks/nextcloud.sh" --user "$user" --local "$local_" --server "$SERVER" 2>&1)"; then
      printf '%s\n' "$out" >> "$LOG"; report "$id" done "Nextcloud set up for $local_ as $user"
    else printf '%s\n' "$out" >> "$LOG"; report "$id" failed "nextcloud.sh: $(printf '%s\n' "$out" | tail -1)"; fi
  else report "$id" skipped "no Nextcloud set-up on this Mac yet ($BASE/tasks/nextcloud.sh)"; fi
}

t_retire() {   # every AD account's files confirmed on the server, then leave the domain and go
  local id="$1" folders u home bad=""
  folders="$(arg folders "$2" || echo Desktop,Documents)"
  for u in $(accounts | awk -F'|' '$2=="mobile"{print $1}'); do
    home="$(home_of "$u")"
    server_has_it_all "$u" "$home" "" "$folders" >/dev/null || bad="$bad $u"
  done
  [ -n "$bad" ] && { report "$id" refused "not everything is on the server yet for:$bad"; return; }
  dsconfigad -force -remove -u none -p none >>"$LOG" 2>&1
  if dsconfigad -show 2>/dev/null | grep -q "Active Directory Domain"; then
    report "$id" failed "dsconfigad could not leave the domain (see $LOG); nothing else changed"; return
  fi
  report "$id" done "left the domain; the helper removes itself now. Erase this Mac by hand (System Settings > General > Transfer or Reset)."
  # Files first: unloading the job ends this script, so nothing after the bootout would run.
  rm -rf /Library/LaunchDaemons/com.arisechurch.helper.plist "$BASE" "$DB"
  launchctl bootout system/com.arisechurch.helper 2>/dev/null
}

# ----- one check-in ----------------------------------------------------------------------
case "${1:-}" in
  --facts)    facts; exit 0 ;;      # what enrol.sh and the check-in send; changes nothing
  --accounts) accounts; exit 0 ;;
  --version)  echo "$VERSION"; exit 0 ;;
esac
load_conf
FORM=(--data-urlencode "helper=$VERSION" --data-urlencode "accounts=$(accounts)")
while IFS= read -r line; do FORM+=(--data-urlencode "$line"); done <<EOF_FACTS
$(facts)
EOF_FACTS
OUT="$(api checkin ${FORM[@]+"${FORM[@]}"} 2>&1)" || die "check-in failed: $OUT"
case "$OUT" in
  HOLD*) nc_pause; log "the server says a service is on: Nextcloud paused, nothing else done"; exit 0 ;;
esac
nc_resume
case "$OUT" in
  # Watch mode (round 7, 4): the server keeps every task but a notice until an admin switches the helper on.
  WATCH*) log "watch mode: $(printf '%s\n' "$OUT" | awk '$1=="WATCH"{print $2; exit}') task(s) would run; none are sent until Switch on in the Macs app" ;;
esac
printf '%s\n' "$OUT" | while read -r word id kind rest; do
  [ "$word" = TASK ] || continue
  log "task $id: $kind $rest"
  case "$kind" in
    add_account|remove_profile|convert_local|unconvert|link_local|login_window|ariseadmin|filevault|printers|bookmarks|certificate|updates|tailscale|nextcloud|retire|welcome|mac_settings|apps|dnsfilter|notice)
      "t_$kind" "$id" "$rest" </dev/null ;;
    *) report "$id" skipped "this helper ($VERSION) does not know $kind" ;;
  esac
done
exit 0
