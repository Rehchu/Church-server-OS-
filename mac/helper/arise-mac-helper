  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict></plist>
EOF_PLIST
  chown root:wheel "$SESSION_AGENT"; chmod 644 "$SESSION_AGENT"
  report "$id" done "the welcome page shows at each person's first sign-in (help: $(cfg_words HELP "$conf" | tr '\n' ',' | sed 's/,$//; s/,/, /g'))"
