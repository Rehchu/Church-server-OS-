            ok("theme copied into the kiosk profile")
        else:
            warn(f"{prof} does not exist: run sudo bash {HOME}/scripts/arise-browser-setup first")
        r = _sp.run(["systemctl", "try-restart", "arise-kiosk.service"], capture_output=True, text=True)
        (ok if r.returncode == 0 else warn)("closet monitor restarted" if r.returncode == 0 else "arise-kiosk.service not restarted: " + r.stderr.strip())
    elif a.sub == "policy":
        r = _sp.run([sys.executable, str(gen), "--config", "/etc/arise/arise.toml"], capture_output=True, text=True)
