        pw = pwd.getpwnam(who)
    except KeyError:
        bad(f"{who} is named in arise.toml but is not an account here"); return
    groups = sorted(g.gr_name for g in grp.getgrall() if who in g.gr_mem)
    print(f"  account    {who} (uid {pw.pw_uid}, home {pw.pw_dir})")
    print(f"  groups     {' '.join(groups) or '(none)'}")
    sud = Path("/etc/sudoers.d/arise-owner")
    (ok if sud.exists() else warn)(f"sudo without a password: {'on' if sud.exists() else 'not set up'} ({sud})")
    # Round 6, 23: [owners] users have the same powers (groups and sudo); the job and Claude stay the owner's.
    others = [str(u) for u in ((load().raw.get("owners") or {}).get("users") or [])]
    sud_txt = sud.read_text() if sud.exists() else ""
    for o in others:
        try:
            pwd.getpwnam(o)
        except KeyError:
            warn(f"also an owner: {o}, but no Linux account by that name here (make one, then: sudo arisectl owner setup)"); continue
        (ok if f"{o} ALL=" in sud_txt else warn)(f"also an owner: {o}" + ("" if f"{o} ALL=" in sud_txt else " (not in the sudo rule yet: sudo arisectl owner setup)"))
    for unit in ("arise-automator.service", "arise-automator-preview.service"):
        d = Path(f"/etc/systemd/system/{unit}.d/10-owner.conf")
        txt = d.read_text() if d.exists() else ""
        (ok if f"User={who}" in txt else bad)(f"{unit} runs as {who}" if f"User={who}" in txt else f"{unit} has no owner drop-in: sudo arisectl automator setup")


