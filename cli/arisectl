def cmd_update(a):
    from arise_server import system, updates
    if a.sub == "apt":
        need_root(); show(system.apt_upgrade()); return
    if a.sub == "refresh":
        need_root(); show(updates.refresh())
    if a.sub == "self":
        need_root()
        r = system.update_arise()
        if r.get("log"): print(r["log"])
        show(r); return
    if a.sub == "queue":
        need_root()
        if not a.name:
            sys.exit("arisectl update queue <package|app|reboot|all|clear> [more...]")
        st = updates.status()
        names = [a.name] + (a.rest or [])
        q = st["queue"]
        if names == ["clear"]:
            show(updates.set_queue([], [], False, "arisectl")); return
        if names == ["all"]:
            show(updates.set_queue([p["name"] for p in st["other"]], [x["name"] for x in st["apps"].get("apps", []) if x.get("update")], st["reboot_required"], "arisectl")); return
        pk = set(q["packages"]); ap = set(q["apps"]); rb = q["reboot"]
        other = {p["name"] for p in st["other"]}; appn = {x["name"] for x in st["apps"].get("apps", [])}
        for n in names:
            if n == "reboot": rb = True
            elif n in other: pk.add(n)
            elif n in appn: ap.add(n)
            else: warn(f"{n}: not a pending package or app; skipped")
        show(updates.set_queue(sorted(pk), sorted(ap), rb, "arisectl")); return
    if a.sub == "apply":
        need_root()
        r = updates.apply(no_snapshot=a.no_snapshot, log=(lambda s: None) if a.quiet else note_)
        if not a.quiet:
            for s in r.get("steps", []):
                (ok if s["ok"] else bad)(s["step"])
            print(f"  {r.get('summary', '')}")
        sys.exit(0 if r.get("ok") else 1)
    st = updates.status()
    head(f"Software Update · window {st['window']}")
    print(f"  security (unattended, installs itself): {len(st['security'])}   other (waits for you): {len(st['other'])}   reboot needed: {'yes' if st['reboot_required'] else 'no'}")
    for p in st["other"]:
        print(f"    {p['name']:<28} {p['from'] or '?':<24} -> {p['version']}")
    ap = st.get("apps", {}).get("apps", [])
    upd = [x["name"] for x in ap if x.get("update")]
    print(f"  apps with a newer image: {', '.join(upd) or 'none'} (checked {st.get('apps', {}).get('checked_at') or 'never'}; dashboard → Software Update → Check apps)")
    q = st["queue"]
    print(f"  queued for {st['window']}: {len(q['packages'])} packages, {len(q['apps'])} apps{', reboot' if q['reboot'] else ''}")
    if st.get("in_service"): warn(f"a service is on now ({st['in_service'].get('name')}): apply is refused until it is over")
    if st.get("arise", {}).get("behind"): warn(f"Arise Server itself is {st['arise']['behind']} commits behind: arisectl update self")
    if st.get("demo"): warn("sample data")


