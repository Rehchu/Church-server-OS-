def cmd_backup(a):
    from arise_server import backups
    cfg = load()
    if a.sub == "status":
        repo = backups.repo()
        head(f"repository {repo.get('repo')}")
        (ok if repo.get("ok") else bad)(f"{repo.get('snapshots', 0)} snapshots, {human_bytes(repo.get('total_size'))} stored" + (f" - {repo['error']}" if repo.get("error") else ""))
        hist = backups.history(limit=400)["rows"]
        head("last run per job")
        rows = []
        for j in backups.jobs()["jobs"]:
            last = next((r for r in hist if r["job"] == j["id"]), None)
            rows.append({"job": j["id"], "last": last["started"][:16] if last else "never", "result": ("ok" if last["ok"] else "FAILED") if last else "-", "added": human_bytes(last["bytes_added"]) if last and last["ok"] else "-", "note": (last.get("error") or last.get("warning") or "")[:80] if last else ""})
        table(rows, ["job", "last", "result", "added", "note"])
        if hist and hist[0].get("demo") or backups.history(5).get("demo"):
            warn("sample data")
    elif a.sub == "jobs":
        table([{"id": j["id"], "name": j.get("name", ""), "paths": " ".join(j.get("paths", [])), "tags": ",".join(j.get("tags", []))} for j in backups.jobs()["jobs"]], ["id", "name", "paths", "tags"])
    elif a.sub == "run":
        need_root()
        if backups.available() and not Path(cfg.backups.restic_repo, "config").exists():
            warn(f"repository not initialised; running restic init at {cfg.backups.restic_repo}")
            r = backups._restic(["init"], 120)
            if not r["ok"]:
                bad((r["err"] or r["out"]).strip()); sys.exit(1)
        ids = [a.job] if a.job else [j["id"] for j in backups.jobs()["jobs"]]
        failed = 0
        for jid in ids:
            print(f"  … {jid}", flush=True)
            r = backups.run_job(jid, blocking=True)
            if r.get("ok"):
                ok(f"{jid}: snapshot {r.get('snapshot_id')}, {human_bytes(r.get('bytes_added'))} added, {r.get('files_new')} new files")
            else:
                failed += 1; bad(f"{jid}: {r.get('err') or r.get('error')}")
        if not a.job:
            print("  … forget/prune", flush=True)
            r = backups.forget_prune()
            (ok if r.get("ok") else bad)("prune " + ("done" if r.get("ok") else (r.get("err") or "")[:200]))
        sys.exit(1 if failed else 0)
    elif a.sub == "snapshots":
        s = backups.snapshots(limit=200)
        table([{"id": x["id"], "time": str(x["time"])[:16], "tags": ",".join(x.get("tags", [])), "paths": " ".join(x.get("paths", []))} for x in s["snapshots"]], ["id", "time", "tags", "paths"])
        if s.get("error"): bad(s["error"])
    elif a.sub == "restore":
        need_root()
        if not a.target:
            sys.exit("--target DIR is required; restores never land on top of live files")
        args = ["restore", a.id, "--target", a.target]
        if a.tag: args += ["--tag", a.tag]
        if a.at: args += ["--time", a.at if " " in a.at else f"{a.at} 23:59:59"]
        if a.path: args += ["--include", a.path]
        print(f"  restic {' '.join(args)}")
        r = backups._restic(args, 6 * 3600)
        show(r)
        ok(f"files are under {a.target}; copy back what you need")
    elif a.sub == "verify":
        need_root()
        r = backups._restic(["check", "--read-data-subset=10%"], 6 * 3600) if backups.available() else {"ok": True, "demo": True}
        if r.get("ok") and not r.get("demo"):
            from arise_server.util import read_json, write_json, now_iso
            sp = cfg.state_dir / "state.json"; st = read_json(sp, default={}); st["restic_last_check"] = now_iso(); st["restic_last_check_ok"] = True; write_json(sp, st)
        show(r)
    elif a.sub == "prune":
        need_root(); show(backups.forget_prune())


def cmd_automator(a):
    from arise_server import automator
    o = automator.overview()
    if a.sub == "status":
        head("automator")
        print(f"  folder     {o['path']}")
        print(f"  schedule   {o.get('schedule')} (next {o.get('next_run')})")
        print(f"  last run   {o.get('last_run') or 'never'}  {o.get('last_summary') or ''}")
        print(f"  quota      {o.get('quota_today') or 0} of {o.get('quota_daily')} units today")
        print(f"  token      {'ok' if o.get('token_ok') else 'MISSING'}" + (f", ~{o['token_days_left']} days left" if o.get("token_days_left") is not None else ""))
        if o.get("token_note"): warn(o["token_note"])
        print(f"  holds      {o.get('holds')} videos, {o.get('rules')} rules; worklist {o.get('worklist_enabled')}/{o.get('worklist_total')} enabled")
        if o.get("demo"): warn("sample data (automator folder not found)")
    elif a.sub in ("preview", "run"):
        if not automator.available():
            sys.exit(f"automator not found at {o['path']}")
        cfg = load()
        p = Path(cfg.automator.path) / "automator"
        cmd = [cfg.automator.python, str(p / "arise_daily.py")] + (["--dry-run"] if a.sub == "preview" else [])
        env = dict(os.environ, PYTHONUTF8="1", PYTHONIOENCODING="utf-8")
        sys.exit(subprocess.call(cmd, cwd=str(p), env=env))
    elif a.sub == "report":
        if a.name:
            print(automator.report(a.name)["text"])
        else:
            print(o["latest_report"])
    elif a.sub == "holds":
        h = automator.holds()
        table([{"video": v.get("id"), "reason": v.get("reason", "")} for v in h["videos"]], ["video", "reason"])
        for r in h["rules"]: print(f"  rule: {r}")
    elif a.sub == "worklist":
        table([{"#": j.get("priority", ""), "job": j.get("id"), "enabled": "yes" if j.get("enabled", True) else "NO", "note": j.get("note", j.get("why", ""))} for j in automator.worklist()["jobs"]], ["#", "job", "enabled", "note"])
    elif a.sub == "schedule":
        need_root()
        if not re.match(r"^\d{2}:\d{2}$", a.time or ""):
            sys.exit("give a time like 02:05")
        cfg = load(); path = Path(cfg.path); text = path.read_text() if path.exists() else ""
        if re.search(r'^\[automator\]', text, re.M):
            sect = re.split(r'(?m)^\[automator\]\s*$', text, 1)
            body, rest = re.split(r'(?m)^(?=\[)', sect[1], 1) if re.search(r'(?m)^\[', sect[1]) else (sect[1], "")
            body = re.sub(r'^(\s*schedule\s*=\s*).*$', f'\\1"{a.time}"', body, count=1, flags=re.M) if re.search(r'^\s*schedule\s*=', body, re.M) else body.rstrip("\n") + f'\nschedule = "{a.time}"\n'
            text = sect[0] + "[automator]" + body + rest
            path.write_text(text)
        else:
            warn(f"no [automator] section in {path}; timer changed only")
        d = Path("/etc/systemd/system/arise-automator.timer.d"); d.mkdir(parents=True, exist_ok=True)
        (d / "override.conf").write_text(f"[Timer]\nOnCalendar=\nOnCalendar=*-*-* {a.time}:00 America/Chicago\n")
        run(["systemctl", "daemon-reload"], timeout=30); run(["systemctl", "restart", "arise-automator.timer"], timeout=30)
        ok(f"automator now runs at {a.time} America/Chicago (remember the quota resets at 02:00)")


