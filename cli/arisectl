#!/usr/bin/env python3
"""arisectl - the Arise Server command line.

    arisectl info                       what this box is and whether it is well
    arisectl doctor                     check everything, say what to fix
    arisectl admin set-password         set the dashboard password

    arisectl service list|status|start|stop|restart <unit>
    arisectl user list|add|remove|passwd|enable|disable|homefix <name>   (add: --display, --password, --groups)
    arisectl group list|add <group>|addmember <group> <user>|removemember <group> <user>
    arisectl computer list|remove <name>
    arisectl share list|add <name> <path> [--group G] [--comment C]|remove <name>
    arisectl backup status|jobs|run [job]|snapshots|restore <id|latest> [--tag T] [--at DATE] [--path P] --target DIR|verify|prune|drill|offsite
    arisectl trash list|sweep [--dry-run]|empty <share>          the Trash on every share (30 days, then the sweep)
    arisectl offboard list|mark <user> --to <user>|cancel <user>|sweep [--dry-run]   someone leaving: 30 days, then disabled, files to the next person
    arisectl browser [status|apply|policy]                      Firefox on the closet monitor: what is installed, rewrite the policy and theme, print the policy
    arisectl repos [status|sync [name] [--dry-run]|setup]       the 8 Arise repos in /srv/arise/repos, two-way with GitHub every 15 minutes
    arisectl audit [words] [--who U] [--failed] [--limit N]      the audit log, newest first (kept forever)
    arisectl ups                        the UPS: charge, runtime, status (nut), or 'not configured'
    arisectl automator status|preview|run|report [name]|holds|worklist|schedule HH:MM|setup|signin [--force]|cutover|unblock
    arisectl app list|templates|catalog|deploy <template> [--name N]|start|stop|restart|update|remove|logs <name>
    arisectl app install-all                 every template deployed, started within the memory budget (the installer's 6a)
    arisectl app autostart <name> on|off     whether an app starts with the box
    arisectl app theme <name>                the house look that app takes (env, files, or CSS to paste)
    arisectl app idle-sweep                  stop desktop apps nobody has used for an hour (arise-idle-apps.timer)
    arisectl automations list|pause <timer>|resume <timer>   every arise-* timer, next run, last result
    arisectl storage status|scan             what is eating the disk (the scan runs in the background)
    arisectl monitor on|off|status           the closet panel (off 23:00, on 06:00 by timer)
    arisectl monitor share on|off            Screen Sharing of that panel through Guacamole, Bradly only
    arisectl nas status|mount|unmount
    arisectl mirror run
    arisectl sites
    arisectl link list|revoke <token>|sweep
    arisectl devices list|scan [--wide]|behind|cameras|name <mac> <name>   everything on the switch, strays, cameras
    arisectl mail status|contacts|import <wix.csv>|test <to> <subject>       the church family list (Resend)
    arisectl mail forward [status|run|export <first.last>]   staff addresses, forwarding only (round 7, 155)
    arisectl remote status|add-peer <name>
    arisectl notify test [alerts|sunday|weekly|daily]|send|discord
    arisectl upkeep hourly|january|changes|health   round 7: the hourly checks, the January report, the change record, disk health
    arisectl security                   the Security app's rows: encryption, scan, certificate, two-step, rescue
    arisectl twofa list|reset <user>    who has two-step sign-in on; reset = turn it off for someone who lost the phone
    arisectl rescue status|rotate|card  the break-glass admin arise-rescue (console only); card writes the closet card
    arisectl encrypt status|tpm         LUKS and the TPM: is the disk encrypted, does the TPM unlock it (clevis)
    arisectl snapshot create "<note>"|list|restore <name>|prune   system snapshots (Timeshift), 5 kept, never during a service
    arisectl scan status|run|restore <file>   the weekly ClamAV scan of the shares; restore puts a quarantined file back
    arisectl reinstall <restic-repo>    rebuild this box from the Synology's backup (docs/REINSTALL.md)
    arisectl archive status|build [--full]|search <words>|setup   the searchable archive of both repos (read-only, docs/ARCHIVE.md)
    arisectl service-now [--quiet]      exit 0 = no service on, 1 = a service is on (the timers' ExecCondition)
    arisectl cloud [status|people|setup [--dry-run]|sweep [--dry-run]|conflicts|app-password <user> "<device>"|revoke <user> ["<device>"]|watch]   Mac and phone syncing (Nextcloud, docs/SYNC.md)
    arisectl update [check|refresh|queue|apply|apt]   Software Update: what waits, what Bradly queued, the Saturday 03:30 apply
    arisectl update apply [--now] [--no-snapshot] [--quiet]   install the queue (refuses during a service; snapshot first)

Reads /etc/arise/arise.toml (or $ARISE_CONFIG). Talks to the same Python
modules the dashboard uses, so the two never disagree.
"""
import argparse
import getpass
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# ---- find the server package and the right interpreter -----------------------
HERE = Path(__file__).resolve()
CANDIDATES = [os.environ.get("ARISE_HOME", ""), str(HERE.parent.parent), "/opt/arise", r"C:\Arise\app"]
HOME = next((Path(c) for c in CANDIDATES if c and (Path(c) / "server" / "arise_server").is_dir()), None)
if HOME is None:
    sys.exit("arisectl: cannot find the server package. Set ARISE_HOME to the repo folder (the one with server/ and cli/).")
VENV_PY = HOME / "venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
if VENV_PY.exists() and Path(sys.executable).resolve() != VENV_PY.resolve() and not os.environ.get("ARISECTL_NO_REEXEC"):
    os.environ["ARISECTL_NO_REEXEC"] = "1"
    os.execv(str(VENV_PY), [str(VENV_PY), str(HERE), *sys.argv[1:]])
sys.path.insert(0, str(HOME / "server"))

from arise_server import VERSION, CODENAME  # noqa: E402
from arise_server.config import load  # noqa: E402
from arise_server.util import human_bytes, run, which  # noqa: E402

RED, GRN, YEL, DIM, BOLD, END = "\033[31m", "\033[32m", "\033[33m", "\033[2m", "\033[1m", "\033[0m"
if not sys.stdout.isatty() or os.name == "nt" and not os.environ.get("WT_SESSION"):
    RED = GRN = YEL = DIM = BOLD = END = ""


def ok(s): print(f"  {GRN}✓{END} {s}")
def warn(s): print(f"  {YEL}!{END} {s}")
def bad(s): print(f"  {RED}✗{END} {s}")
def head(s): print(f"\n{BOLD}{s}{END}")


def table(rows, cols):
    if not rows:
        print("  (none)"); return
    widths = [max(len(str(c)), *(len(str(r.get(c, ""))) for r in rows)) for c in cols]
    print("  " + "  ".join(f"{DIM}{c.upper():<{w}}{END}" for c, w in zip(cols, widths)))
    for r in rows:
        print("  " + "  ".join(f"{str(r.get(c, '')):<{w}}" for c, w in zip(cols, widths)))


def show(res):
    """Print a {ok, out, err} result and exit non-zero on failure."""
    if isinstance(res, dict):
        if res.get("demo"):
            warn("sample mode: nothing was changed (no config / tool not installed)")
        if res.get("out"): print(res["out"].rstrip())
        if res.get("ok") is False:
            bad(res.get("err") or res.get("error") or "failed"); sys.exit(1)
        elif res.get("err") and res.get("ok"):
            print(res["err"].rstrip())
    ok("done")


def need_root():
    if os.name != "nt" and hasattr(os, "geteuid") and os.geteuid() != 0:
        sys.exit("arisectl: this needs root. Run it with sudo.")


def _actor() -> str:
    """Who ran this: the sudo user, "+claude" when Claude Code ran it (its shell carries CLAUDECODE).
    Round 7, 140: the change record in About says Bradly, Kristina or Claude."""
    who = os.environ.get("SUDO_USER") or os.environ.get("USER") or "root"
    return who + ("+claude" if os.environ.get("CLAUDECODE") else "")


# Verbs that only read: not a change, not in the change record.
READ_ONLY = {"status", "list", "jobs", "snapshots", "info", "doctor", "templates", "catalog", "logs", "report", "holds",
             "worklist", "contacts", "behind", "cameras", "changes", "health", "discord", "people", "conflicts", "verify", None}


def _record_change(a) -> None:
    sub = getattr(a, "sub", None)
    if a.cmd in ("doctor", "info", "audit", "service-now", "security", "storage", "automations") or sub in READ_ONLY:
        return
    if os.name == "nt" or not hasattr(os, "geteuid") or os.geteuid() != 0:
        return   # only root changes the box; a non-root read never lands in the record
    try:
        from arise_server import audit
        target = " ".join(str(x) for x in (getattr(a, "name", None), getattr(a, "job", None)) if x)
        audit.record(_actor(), f"arisectl.{a.cmd}" + (f".{sub}" if sub else ""), target[:80])
    except Exception:  # noqa: BLE001 - the command itself never fails because of the record
        pass


# ---- commands -----------------------------------------------------------------
def cmd_info(a):
    cfg = load()
    from arise_server import metrics
    st = metrics.static_info()
    head(f"Arise Server v{VERSION} “{CODENAME}”")
    print(f"  host      {st['hostname']}  ({st['os']}, {st['cpu_count']} cores, {st['ram_total_h']} RAM)")
    print(f"  profile   {cfg.system.profile}   config {cfg.path} {'' if cfg.found else '(MISSING - defaults)'}")
    print(f"  realm     {cfg.directory.realm} / {cfg.directory.netbios}   directory {'on' if cfg.directory.enabled else 'off'}")
    print(f"  web       http://{cfg.system.hostname}:{cfg.web.port}   password {'set' if cfg.web.admin_password_hash else 'NOT SET'}")
    print(f"  automator {cfg.automator.path}  at {cfg.automator.schedule}")
    print(f"  backups   {cfg.backups.restic_repo}  at {cfg.backups.schedule}")
    print(f"  nas       {cfg.nas.protocol}://{cfg.nas.host}/{cfg.nas.share} -> {cfg.nas.mount}")
    if cfg.demo:
        warn("sample mode: no config file found, every module answers with sample data")


def cmd_doctor(a):
    cfg = load()
    head("arisectl doctor")
    (ok if cfg.found else bad)(f"config {cfg.path}" + ("" if cfg.found else " is missing - copy config/arise.toml.example there"))
    (ok if cfg.web.admin_password_hash else bad)("dashboard password " + ("set" if cfg.web.admin_password_hash else "not set - run: sudo arisectl admin set-password"))
    # Disk health: SMART says a disk is dying before it dies. smartd watches; this prints the verdict.
    if which("smartctl"):
        disks = [l.split()[0] for l in run(["lsblk", "-dno", "NAME,TYPE"], timeout=5)["out"].splitlines() if l.split()[-1:] == ["disk"]]
        for dname in disks:
            r = run(["smartctl", "-H", f"/dev/{dname}"], timeout=20)
            out = r["out"] + r["err"]
            if "PASSED" in out or "OK" in out and "FAILED" not in out:
                ok(f"SMART /dev/{dname}: PASSED")
            elif "FAILED" in out:
                bad(f"SMART /dev/{dname}: FAILED - back up now and replace the disk")
            else:
                warn(f"SMART /dev/{dname}: no SMART verdict (a VM, a USB bridge, or an unsupported disk)")
    else:
        warn("smartctl missing (install.sh step 6f installs smartmontools); disk health not checked")
    if Path("/etc/arise/staging").exists():
        warn("STAGING: not at the church yet; the domain is on loopback only, no scan runs. At the church: sudo bash /opt/arise/installer/install.sh")
    # The address install.sh pinned (the one DHCP gave the box) must still be the box's address.
    pinned = Path("/etc/netplan/60-arise-pinned.yaml")
    if pinned.exists():
        import re as _re
        m = _re.search(r"addresses:\s*\[([0-9.]+)/", pinned.read_text())
        cur = run(["sh", "-c", "ip -o route get 1.1.1.1 | awk '{for(i=1;i<=NF;i++) if($i==\"src\") print $(i+1)}'"], timeout=5)["out"].strip()
        if m and cur:
            (ok if m.group(1) == cur else bad)(f"pinned address {m.group(1)} " + ("is this box's address" if m.group(1) == cur else f"but the box answers as {cur}: another device may hold it; reboot, then re-run install.sh step 2b"))
    else:
        warn("address not pinned (no /etc/netplan/60-arise-pinned.yaml); if the router ever hands this box a new address the Macs lose the domain. Run install.sh again, or INSTALL.md § 5")
    for mod in ("fastapi", "uvicorn", "psutil", "yaml", "bcrypt"):
        try:
            __import__(mod); ok(f"python module {mod}")
        except ImportError:
            bad(f"python module {mod} missing - pip install -r server/requirements.txt")
    if cfg.directory.enabled:
        if which("samba-tool"):
            r = run(["samba-tool", "domain", "info", "127.0.0.1"], timeout=15)
            (ok if r["ok"] else bad)("Samba AD DC " + ("answers" if r["ok"] else f"not answering: {((r['err'] or r['out']).strip().splitlines() or [''])[-1][:160]}"))
            d = run(["host", "-t", "SRV", f"_ldap._tcp.{cfg.directory.realm.lower()}"], timeout=10) if which("host") else {"ok": None}
            if d["ok"] is not None:
                (ok if d["ok"] else bad)(f"DNS SRV for {cfg.directory.realm.lower()} " + ("resolves" if d["ok"] else "does not resolve - resolv.conf must point at 127.0.0.1"))
            h = Path(cfg.directory.homes_path)
            (ok if h.is_dir() else warn)(f"homes folder {h}" + ("" if h.is_dir() else " missing"))
        else:
            bad("samba-tool not installed (directory is enabled) - apt install samba")
    if cfg.automator.enabled:
        p = Path(cfg.automator.path)
        (ok if (p / "automator" / "arise_daily.py").exists() else bad)(f"automator at {p}" + ("" if (p / "automator" / "arise_daily.py").exists() else " - clone Rehchu/arise-youtube-automation there"))
        (ok if (p / "token.json").exists() else bad)("token.json " + ("present" if (p / "token.json").exists() else "missing - run authorize.py as the channel owner and copy it in"))
        (ok if (p / "client_secret.json").exists() else bad)("client_secret.json " + ("present" if (p / "client_secret.json").exists() else "missing - download from Google Cloud, project iconic-vine-505702-i5"))
        for mod in ("googleapiclient", "google_auth_oauthlib", "PIL"):
            try:
                __import__(mod); ok(f"automator library {mod}")
            except ImportError:
                bad(f"automator library {mod} missing")
    if which("restic"):
        ok("restic installed")
        pw = Path(cfg.backups.password_file)
        (ok if pw.exists() else bad)(f"restic password file {pw}" + ("" if pw.exists() else " missing - write one and keep a paper copy"))
        rp = Path(cfg.backups.restic_repo)
        (ok if rp.exists() else warn)(f"repository {rp}" + ("" if rp.exists() else " not present (NAS not mounted, or not initialised: arisectl backup run initialises it)"))
    else:
        bad("restic not installed - apt install restic")
    if cfg.nas.enabled:
        (ok if os.path.ismount(cfg.nas.mount) else warn)(f"Synology {cfg.nas.mount} " + ("mounted" if os.path.ismount(cfg.nas.mount) else "not mounted - arisectl nas mount"))
    if cfg.apps.docker:
        d = run(["docker", "info"], timeout=10) if which("docker") else {"ok": False}
        (ok if d["ok"] else warn)("docker " + ("running" if d["ok"] else "not running - apps cannot start"))
    if which("systemctl"):
        for u in ("arise-web.service", "arise-automator.timer", "arise-backup.timer", "arise-mirror.timer", "arise-update.timer"):
            r = run(["systemctl", "is-active", u], timeout=5)
            (ok if r["ok"] else warn)(f"{u} {r['out'].strip() or 'inactive'}")
    # Round 3: the safety basics, one line each.
    try:
        from arise_server import security as _sec
        est = _sec.encrypt_status()
        if est.get("luks"):
            (ok if est.get("tpm_bound") else warn)("disk encryption: LUKS " + ("+ TPM unlock (boots alone)" if est.get("tpm_bound") else "but no TPM binding: sudo arisectl encrypt tpm (a reboot waits for the passphrase until then)"))
        else:
            warn("disk not encrypted (LUKS is picked in the Ubuntu installer; docs/SECURITY.md)")
        import pwd as _pwd
        try:
            _pwd.getpwnam(_sec.RESCUE_USER); ok(f"break-glass admin {_sec.RESCUE_USER} exists")
        except KeyError:
            warn(f"no {_sec.RESCUE_USER} account (install.sh step 6j makes it)")
        (ok if which("clamscan") else warn)("clamav " + ("installed; arise-clamscan.timer Sunday 23:30" if which("clamscan") else "missing (install.sh step 6j)"))
        (ok if which("timeshift") else warn)("timeshift " + ("installed; a snapshot before each update" if which("timeshift") else "missing (install.sh step 6j)"))
        (ok if Path(_sec.CADDY_ROOT).exists() else warn)("church certificate " + ("present (Caddy)" if Path(_sec.CADDY_ROOT).exists() else "absent: Caddy has not run; the LAN dashboard is plain http"))
    except Exception as _e:  # doctor must finish
        warn(f"safety checks skipped: {_e}")
    # The apps' caps (round 3, 40): what autostarts must fit in RAM minus the reserve.
    try:
        from arise_server import apps as _apps
        cc = _apps.caps_check()
        (ok if cc["ok"] else warn)(f"app caps: {cc['count']} autostart apps capped at {cc['autostart_caps_mb']} MB total (about {cc['autostart_est_mb']} MB in use), budget {cc['budget_mb']} MB of {cc['ram_mb']} MB RAM" + ("" if cc["ok"] else " - over budget: set autostart off on the heaviest (arisectl app autostart <name> off)"))
    except Exception as e:  # noqa: BLE001
        warn(f"app caps not checked: {e}")
    # The closet monitor (round 3, 17 and 30), only where the kiosk is installed.
    if Path("/etc/systemd/system/arise-kiosk.service").exists():
        for u in ("arise-monitor-off.timer", "arise-monitor-on.timer"):
            r = run(["systemctl", "is-enabled", u], timeout=5)
            (ok if r["ok"] else warn)(f"{u} {r['out'].strip() or 'absent'}" + ("" if r["ok"] else " - the panel will not sleep at 23:00; re-run install.sh --kiosk"))
        wv = run(["systemctl", "is-active", "arise-wayvnc.service"], timeout=5)["out"].strip()
        (ok if wv == "active" else warn)(f"screen sharing (wayvnc) {wv or 'off'}" + ("" if wv == "active" else " - arisectl monitor share on"))
    if which("timedatectl"):
        r = run(["timedatectl", "show", "-p", "NTPSynchronized", "--value"], timeout=5)
        (ok if r["out"].strip() == "yes" else warn)("clock " + ("synchronised" if r["out"].strip() == "yes" else "NOT synchronised - Kerberos breaks past 5 minutes of drift"))
    print()


def cmd_admin(a):
    if a.sub != "set-password":
        sys.exit("arisectl admin set-password")
    need_root()
    cfg = load()
    from arise_server.auth import hash_password
    p1 = getpass.getpass("New dashboard password: ")
    p2 = getpass.getpass("Again: ")
    if p1 != p2 or len(p1) < 8:
        sys.exit("passwords differ or shorter than 8 characters; nothing changed")
    h = hash_password(p1)
    path = Path(cfg.path)
    if not path.exists():
        ex = HOME / "config" / "arise.toml.example"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(ex.read_text() if ex.exists() else '[web]\nadmin_user = "bradly"\nadmin_password_hash = ""\n')
        warn(f"created {path} from the example")
    text = path.read_text()
    if re.search(r'^\s*admin_password_hash\s*=', text, re.M):
        text = re.sub(r'^(\s*admin_password_hash\s*=\s*).*$', lambda m: f'{m.group(1)}"{h}"', text, count=1, flags=re.M)
    elif re.search(r'^\[web\]', text, re.M):
        text = re.sub(r'^\[web\]\s*$', f'[web]\nadmin_password_hash = "{h}"', text, count=1, flags=re.M)
    else:
        text += f'\n[web]\nadmin_password_hash = "{h}"\n'
    path.write_text(text)
    try:
        os.chmod(path, 0o640)
    except OSError:
        pass
    ok(f"password hash written to {path} for user '{cfg.web.admin_user}'")
    if which("systemctl"):
        run(["systemctl", "restart", "arise-web.service"], timeout=30)
        ok("arise-web restarted")
    else:
        warn("restart the dashboard to pick it up")


def cmd_service(a):
    from arise_server import services
    if a.sub == "list":
        r = services.list_services()
        table([{"unit": s["unit"], "name": s["name"], "state": f"{s['active']} {s['sub']}".strip()} for s in r["services"]], ["unit", "name", "state"])
        if r.get("demo"): warn("sample data")
    elif a.sub == "status":
        print(run(["systemctl", "status", a.name, "--no-pager"], timeout=15)["out"])
    else:
        need_root(); show(services.act(a.name, a.sub))


def cmd_user(a):
    from arise_server import directory
    if a.sub == "list":
        r = directory.list_users()
        table([{"user": u["name"], "name": u["display"], "enabled": "yes" if u["enabled"] else "NO", "groups": ", ".join(u["groups"]), "last login": u["last_logon"] or "never"} for u in r["users"]], ["user", "name", "enabled", "groups", "last login"])
    elif a.sub == "add":
        need_root()
        if getattr(a, "password_stdin", False):
            pw = sys.stdin.readline().rstrip("\n")
        else:
            pw = a.password or getpass.getpass(f"Password for {a.name}: ")
        show(directory.add_user(a.name, pw, a.display or "", a.groups.split(",") if a.groups else [], temporary=not a.permanent))
    elif a.sub == "remove":
        need_root()
        if input(f"Type the user name to remove it from the domain (home folder is kept): ") != a.name:
            sys.exit("not confirmed; nothing changed")
        show(directory.delete_user(a.name, a.name))
    elif a.sub == "passwd":
        need_root(); show(directory.set_password(a.name, a.password or getpass.getpass(f"New password for {a.name}: "), temporary=not a.permanent))
    elif a.sub in ("enable", "disable"):
        need_root(); show(directory.enable_user(a.name, a.sub == "enable"))
    elif a.sub == "homefix":
        need_root()
        cfg = load()
        p = Path(cfg.directory.homes_path) / a.name
        p.mkdir(parents=True, exist_ok=True)
        r = run(["chown", "-R", f"{cfg.directory.netbios}\\{a.name}:Domain Users", str(p)], timeout=600)
        if not r["ok"]:
            r = run(["chown", "-R", f"{a.name}:", str(p)], timeout=600)
        os.chmod(p, 0o700)
        show(r)


def cmd_directory(a):
    """The day-one people list (round 5, 8): arisectl directory import people.csv [--apply]."""
    from arise_server import profiles
    if a.sub != "import" or not a.file:
        sys.exit("usage: arisectl directory import people.csv [--apply]   (columns: " + ", ".join(profiles.COLUMNS) + ")")
    if a.apply:
        need_root()
    try:
        text = Path(a.file).read_text(encoding="utf-8-sig")
    except OSError as e:
        sys.exit(f"could not read {a.file}: {e}")
    r = profiles.import_people(text, bool(a.apply), _actor())
    if not r.get("ok"):
        bad(r.get("err", "the list was refused")); sys.exit(1)
    head(("creating" if a.apply else "checking (nothing is created without --apply)") + f": {len(r['rows'])} rows, mail @{r['mail_domain']}, realm {r['realm']}")
    for row in r["rows"]:
        tag = f"line {row['line']}: {row['user'] or '?'}"
        if not row["ok"]:
            bad(f"{tag}  {row['err']}")
            continue
        extra = f"  ({', '.join(row['groups'])})" if row["groups"] else ""
        ok(f"{tag}  {row['title'] + ' ' if row['title'] else ''}{row['display']}{extra}" + ("" if a.apply else "  would be created"))
        for w in row.get("warnings", []):
            warn(f"    {w}")
    if a.apply and r["created"]:
        # The one place the temporary passwords appear: this screen. Not in a log, not on disk.
        head("temporary passwords: print this, hand each one over, then close the window")
