def main():
    a = build().parse_args()
    # argparse quirks: restore's id and schedule's time share the positional
    if a.cmd == "backup": a.id = a.job
    if a.cmd == "automator": a.time = a.name
    if a.cmd == "app":
        if a.sub == "deploy": a.template, a.name = a.name, (a.instance or a.name)
    for needed in (("service", ("status", "start", "stop", "restart")), ("user", ("add", "remove", "passwd", "enable", "disable", "homefix")), ("group", ("add", "addmember", "removemember")), ("computer", ("remove",)), ("share", ("add", "remove")), ("app", ("deploy", "start", "stop", "restart", "update", "remove", "logs", "autostart", "theme")), ("automations", ("pause", "resume"))):
        if a.cmd == needed[0] and a.sub in needed[1] and not a.name:
            sys.exit(f"arisectl {a.cmd} {a.sub} needs a name")
    _record_change(a)
    try:
        a.f(a)
    except KeyboardInterrupt:
        sys.exit(130)
    except EOFError:
        # input() with no terminal (a script, a pipe, systemd): nothing was typed, so nothing changes
        sys.exit("arisectl: no answer typed (no terminal?); nothing was changed")


if __name__ == "__main__":
    main()
