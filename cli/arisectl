    import subprocess as _sp
    pol = Path("/etc/firefox/policies/policies.json")
    prof = Path("/var/lib/arise/browser")
    import shutil
    gen = HOME / "scripts" / "arise-browser-policies.py"
    if a.sub == "status":
        head("browser (closet monitor)")
        v = _sp.run(["dpkg-query", "-W", "-f=${Version}", "firefox"], capture_output=True, text=True) if which("dpkg-query") else None
        ver = (v.stdout.strip() if v and v.returncode == 0 else "")
        (ok if ver and "snap" not in ver else warn)("firefox " + (ver or "not installed: sudo bash /opt/arise/scripts/arise-browser-setup") + (" (the snap stub; the setup replaces it)" if "snap" in ver else ""))
        (ok if pol.exists() else warn)(f"policy {pol}" + ("" if pol.exists() else " missing: sudo arisectl browser apply"))
        if pol.exists():
            try:
                p = _json.loads(pol.read_text())["policies"]
                wf = p.get("WebsiteFilter")
                ok("sites: " + (f"{len(wf.get('Exceptions', []))} allowed, everything else blocked" if wf else "open web (any site)"))
            except (ValueError, KeyError) as e:
                bad(f"policy unreadable: {e}")
        for f in ("chrome/userChrome.css", "chrome/userContent.css", "user.js"):
