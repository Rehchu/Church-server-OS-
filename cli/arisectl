def cmd_ups(a):
    """The UPS through NUT: upsc <name>@localhost. Not configured until the model is known."""
    import configparser
    conf = Path("/etc/nut/ups.conf")
    name = ""
    if conf.exists():
        for line in conf.read_text().splitlines():
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                name = line[1:-1]; break
    mode = ""
    nut = Path("/etc/nut/nut.conf")
    if nut.exists():
        m_ = re.search(r"^MODE\s*=\s*(\w+)", nut.read_text(), re.M)
        mode = m_.group(1) if m_ else ""
    if not name or mode in ("", "none"):
        warn("UPS not configured yet: the model is unknown (docs/ANSWERS.md 8). When it is: uncomment the [arise] stanza in /etc/nut/ups.conf,")
        warn("set MODE=standalone in /etc/nut/nut.conf, then: sudo systemctl restart nut-server nut-monitor; sudo arisectl ups")
        return
    if not which("upsc"):
        bad("nut-client is not installed (install.sh without --no-ups installs it)"); return
    r = run(["upsc", f"{name}@localhost"], timeout=10)
    if not r["ok"]:
        bad(f"upsc {name}@localhost: {(r['err'] or r['out']).strip()[:200]}"); return
    want = {"ups.status": "status", "battery.charge": "charge %", "battery.runtime": "runtime s", "ups.load": "load %", "input.voltage": "input V", "ups.model": "model"}
    rows = {}
    for line in r["out"].splitlines():
        k, _, v = line.partition(":")
        if k.strip() in want:
            rows[want[k.strip()]] = v.strip()
    for k in want.values():
        if k in rows:
            print(f"  {k:10} {rows[k]}")
    st = rows.get("status", "")
    (ok if "OL" in st else warn)("on line power" if "OL" in st else f"status {st or 'unknown'}: on battery, or no reading")
    print("  upsmon shuts the box down cleanly when the UPS reports LOW BATTERY (its own threshold), by Bradly's choice (answer 48)")


def cmd_backup(a):
    from arise_server import backups
    cfg = load()
    if a.sub == "status":
        repo = backups.repo()
        head(f"repository {repo.get('repo')}")
        (ok if repo.get("ok") else bad)(f"{repo.get('snapshots', 0)} snapshots, {human_bytes(repo.get('total_size'))} stored" + (f" - {repo['error']}" if repo.get("error") else ""))
        hist = backups.history(limit=400)["rows"]
        head("last run per job")
        rows = []
        for j in backups.jobs()["jobs"]:
            last = next((r for r in hist if r["job"] == j["id"]), None)
            rows.append({"job": j["id"], "last": last["started"][:16] if last else "never", "result": ("ok" if last["ok"] else "FAILED") if last else "-", "added": human_bytes(last["bytes_added"]) if last and last["ok"] else "-", "note": (last.get("error") or last.get("warning") or "")[:80] if last else ""})
        table(rows, ["job", "last", "result", "added", "note"])
        if hist and hist[0].get("demo") or backups.history(5).get("demo"):
            warn("sample data")
    elif a.sub == "jobs":
        table([{"id": j["id"], "name": j.get("name", ""), "paths": " ".join(j.get("paths", [])), "tags": ",".join(j.get("tags", []))} for j in backups.jobs()["jobs"]], ["id", "name", "paths", "tags"])
    elif a.sub == "run":
        need_root()
        # The live target (round 5, row 15): a local folder on the Synology or sftp to Arise-Home.
        # `restic cat config` answers for either; only a repository that is not there yet is initialised.
        live = backups.live_repo()
        if backups.available() and live and not backups._restic(["cat", "config"], 60)["ok"]:
            warn(f"repository not initialised (or not reachable); running restic init at {live}")
            r = backups._restic(["init"], 120)
            if not r["ok"]:
                bad((r["err"] or r["out"]).strip()); sys.exit(1)
        ids = [a.job] if a.job else [j["id"] for j in backups.jobs()["jobs"]]
        failed = 0
        for jid in ids:
            print(f"  … {jid}", flush=True)
            r = backups.run_job(jid, blocking=True)
            if r.get("ok"):
                ok(f"{jid}: snapshot {r.get('snapshot_id')}, {human_bytes(r.get('bytes_added'))} added, {r.get('files_new')} new files")
            else:
                failed += 1; bad(f"{jid}: {r.get('err') or r.get('error')}")
        if not a.job:
            print("  … forget/prune", flush=True)
            r = backups.forget_prune()
            (ok if r.get("ok") else bad)("prune " + ("done" if r.get("ok") else (r.get("err") or "")[:200]))
            # Round 7, 53/54: Arise-Home is the off-site copy; raw recordings never go.
            print("  … off-site copy", flush=True)
            o = backups.offsite_copy()
            if o.get("skipped"):
                warn(f"off-site: {o.get('note')}")
            elif o.get("ok"):
                (warn if o.get("warning") else ok)("off-site: " + (o.get("warning") or o.get("note") or f"{o.get('copied', 0)} snapshots on Arise-Home"))
            else:
                failed += 1; bad(f"off-site: {o.get('error')}")
        sys.exit(1 if failed else 0)
    elif a.sub == "offsite":
        need_root()
        o = backups.offsite_copy()
        if o.get("ok"):
            (warn if o.get("warning") or o.get("skipped") else ok)(o.get("warning") or o.get("note") or f"{o.get('copied', 0)} snapshots on Arise-Home")
        else:
            bad(o.get("error")); sys.exit(1)
    elif a.sub == "snapshots":
        s = backups.snapshots(limit=200)
        table([{"id": x["id"], "time": str(x["time"])[:16], "tags": ",".join(x.get("tags", [])), "paths": " ".join(x.get("paths", []))} for x in s["snapshots"]], ["id", "time", "tags", "paths"])
        if s.get("error"): bad(s["error"])
    elif a.sub == "restore":
        need_root()
        if not a.target:
            sys.exit("--target DIR is required; restores never land on top of live files")
        args = ["restore", a.id, "--target", a.target]
        if a.tag: args += ["--tag", a.tag]
        if a.at: args += ["--time", a.at if " " in a.at else f"{a.at} 23:59:59"]
        if a.path: args += ["--include", a.path]
        print(f"  restic {' '.join(args)}")
        r = backups._restic(args, 6 * 3600)
        show(r)
        ok(f"files are under {a.target}; copy back what you need")
    elif a.sub == "drill":
        need_root()
        r = backups.drill(quiet=a.quiet)
        # Round 7, 56: the drill's result is a line in Discord #weekly (once per drill).
        from arise_server import discord
        discord.post("weekly", backups.drill_line(r), key=f"drill:{str(r.get('when', ''))[:16]}",
                     fix="" if r.get("ok") else "sudo arisectl backup drill")
        if a.quiet:
            sys.exit(0 if r.get("ok") else 1)
        (ok if r.get("ok") else bad)(f"drill {r.get('when', '')[:16]}: {r.get('file') or '-'} ({human_bytes(r.get('bytes'))}) from snapshot {r.get('snapshot') or '-'}")
        print(f"  {r.get('note')}")
        if r.get("matched") is True: ok("restored copy matches the live file")
        elif r.get("matched") is False: warn("restored copy differs from the live file (it changed since the snapshot)")
        if r.get("demo"): warn("sample data")
        sys.exit(0 if r.get("ok") else 1)
    elif a.sub == "verify":
        need_root()
        r = backups._restic(["check", "--read-data-subset=10%"], 6 * 3600) if backups.available() else {"ok": True, "demo": True}
        if r.get("ok") and not r.get("demo"):
