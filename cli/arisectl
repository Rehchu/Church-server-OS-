def cmd_service_now(a):
    """The scheduled jobs' gate (ExecCondition=): nothing runs during a service.

    Bradly's rule: nothing is scheduled during a service (Sundays 10:30, Mondays
    19:00; the times come from [church] in arise.toml). A timer that fires inside
    that window, or a Persistent= catch-up after a power cut during one, is
    skipped quietly: systemd treats ExecCondition exit 1 as "condition failed",
    not as a failure. Exit 0 = go, 1 = a service is on.
    """
    from arise_server import church
    try:
        svc = church.in_service_now()
    except Exception as e:  # a broken config must not stop the backups: go, and say why
        if not a.quiet:
            warn(f"could not read the service times ({e}); not gating")
        sys.exit(0)
    if svc:
        if not a.quiet:
            print(f"{svc['name']} is on until {svc['ends_at']}: skipped")
        else:
            print(f"skipped: {svc['name']} until {svc['ends_at']}")
        sys.exit(1)
    if not a.quiet:
        ok("no service on now")
    sys.exit(0)


# ---- argument parsing ----------------------------------------------------------
def build():
    ap = argparse.ArgumentParser(prog="arisectl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"arisectl {VERSION} ({CODENAME})")
    sp = ap.add_subparsers(dest="cmd", required=True)
    sp.add_parser("info").set_defaults(f=cmd_info)
    sp.add_parser("doctor").set_defaults(f=cmd_doctor)
