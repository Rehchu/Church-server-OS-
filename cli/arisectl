def cmd_nas(a):
    from arise_server import nas
    if a.sub == "status":
        n = nas.status()
        head(f"{n['protocol']}://{n['host']}/{n.get('share', '')} -> {n['mount']}")
        (ok if n.get("mounted") else bad)("mounted" if n.get("mounted") else "not mounted")
        if n.get("total"): print(f"  {human_bytes(n['free'])} free of {human_bytes(n['total'])}")
        d = n.get("dsm")
        if d: (ok if d.get("ok") else warn)(f"DSM: {d.get('model') or ''} {d.get('version') or ''} volumes {d.get('volume_status') or ''}" if d.get("ok") else f"DSM not readable: {d.get('error')}")
        if n.get("demo"): warn("sample data")
    elif a.sub == "mount":
        need_root(); show(nas.mount())
    elif a.sub == "unmount":
        need_root(); show(nas.unmount())


