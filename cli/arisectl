def cmd_remote(a):
    from arise_server import remote
    if a.sub == "status":
        o = remote.overview()
        head("ssh")
        (ok if o["ssh"]["active"] else bad)(f"sshd {'active' if o['ssh']['active'] else 'down'} on port {o['ssh']['port']}, password auth {'ON' if o['ssh']['password_auth'] else 'off'}, {o['ssh']['keys']} authorized keys")
        ts = o.get("tailscale") or {}
        head("tailscale")
        if not ts.get("installed"): warn("not installed (docs/REMOTE-ACCESS.md)")
        elif not ts.get("up"): bad(f"installed but not up: {ts.get('error', '')}")
        else:
            ok(f"{ts['self']['name']} {ts['self']['ip']} {ts['self'].get('dns', '')}; routes {', '.join(ts.get('subnet_routes') or []) or 'none'}")
            table([{"peer": p["name"], "ip": p["ip"], "os": p["os"], "online": "yes" if p["online"] else "no", "last seen": p["last_seen"]} for p in ts.get("peers", [])], ["peer", "ip", "os", "online", "last seen"])
        wg = o.get("wireguard") or {}
        head("wireguard")
        if not wg.get("installed"): warn("not installed")
        elif not wg.get("up"): bad(f"{wg.get('interface')} not up: {wg.get('error', '')}")
        else:
            ok(f"{wg['interface']} up, endpoint {wg.get('endpoint') or '(set wg_endpoint)'}")
            table([{"peer": p["name"], "ip": p["ip"], "handshake": p["handshake"], "online": "yes" if p["online"] else "no"} for p in wg.get("peers", [])], ["peer", "ip", "handshake", "online"])
        g = o.get("guacamole") or {}
        head("remote desktop (guacamole)")
        (ok if g.get("running") else warn)(f"{'running' if g.get('running') else 'not running'} at {g.get('url')}")
        if o.get("demo"): warn("sample data")
    elif a.sub == "add-peer":
        need_root()
        if not a.name: sys.exit("arisectl remote add-peer <name>")
        r = remote.add_wireguard_peer(a.name)
        if not r.get("ok"): bad(r.get("err")); sys.exit(1)
        ok(f"peer {r['name']} added" + (f" as {r.get('ip')}" if r.get("ip") else ""))
        print("\n--- paste this into the WireGuard app on that computer ---\n" + r["config"])


